# ====================================================
# SMART SCHOOL ERP - PRODUCTION ENVIRONMENT CONFIG
# ====================================================

# Port for Cloud Providers (Render, Railway, Fly.io automatically supply PORT)
PORT=8000

# Secret Key for JWT Tokens and Authentication Security
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret

# Database URL
# For Local SQLite:
DATABASE_URL=sqlite+aiosqlite:///secure_school.db
# For Production PostgreSQL (e.g. Render PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/dbname

# CORS Allowed Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=https://smart-school-erp.vercel.app,https://smartschool-cloud-erp.onrender.com

# Automated Security Incident Alerting (Optional)
ENABLE_SECURITY_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
