    try {
        const fd = new URLSearchParams(); fd.append('username', document.getElementById('username').value); fd.append('password', document.getElementById('password').value);
        const r = await fetch(`${API}/auth/login`, {method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:fd});
        if (!r.ok) { const e = await r.json(); throw new Error(e.detail || 'ظپط´ظ„'); }
        token = (await r.json()).access_token;
        const mr = await fetch(`${API}/auth/me`, {headers:{'Authorization':`Bearer ${token}`}}); me = await mr.json();
        
        document.getElementById('welcomeName').textContent = `ظ…ط±ط­ط¨ط§ظ‹طŒ ${me.username}`;
        document.getElementById('userRole').textContent = uType === 'admin' ? 'ظ…ط¯ظٹط± ظ†ط¸ط§ظ… (Super Admin)' : (uType === 'school_admin' ? 'ظ…ط¯ظٹط± ظ…ط¯ط±ط³ط©' : 'ظ…ط¹ظ„ظ…');
        
        document.getElementById('loginWrapper').style.display = 'none';
        document.getElementById('appLayout').style.display = 'flex';
        
        if (uType === 'admin') {
              if (document.getElementById('megaMenuContainer')) document.getElementById('megaMenuContainer').style.display = 'none';
              if (document.getElementById('saasMegaCard')) document.getElementById('saasMegaCard').style.display = 'block';
              goTo('pg-saas-admin');
          } else {
              if (document.getElementById('megaMenuContainer')) document.getElementById('megaMenuContainer').style.display = 'flex';
              if (document.getElementById('saasMegaCard')) document.getElementById('saasMegaCard').style.display = 'none';
              await loadApiData(); refreshAll();
              goTo('pg-home-menu');
          }
    } catch(e) { err.textContent = e.message; err.style.display = 'block'; }
    finally { btn.disabled = false; }
});
function logout(e) { 
    if(e) e.preventDefault(); 
    token = null; me = null; 
    document.getElementById('appLayout').style.display = 'none'; 
    document.getElementById('loginWrapper').style.display = 'flex'; 
    const err = document.getElementById('loginError');
    if (err) err.style.display = 'none';
}

// ==================== طھط­ظ…ظٹظ„ ط¨ظٹط§ظ†ط§طھ API ====================
async function loadApiData() {
    try {
        const r = await fetch(`${API}/finance/dashboard/students`, {headers:{'Authorization':`Bearer ${token}`}});
        DB.students = await r.json();
        // ط¥ظ†ط´ط§ط، ط¨ظٹط§ظ†ط§طھ ط§ظ„طھط³ط¬ظٹظ„ ظˆط§ظ„ط£ظ‚ط³ط§ط· ظ…ظ† ط¨ظٹط§ظ†ط§طھ ط§ظ„ط·ظ„ط§ط¨
        DB.students.forEach((s, i) => {
            const isPaid = s.financial_status === 'ظ…ط³ط¯ط¯';
            DB.enrollment.push({id: i+1, studentId: s.id, studentName: s.full_name, year: '2025-2026', stage: 'ط§ظ„ظ…ط±ط­ظ„ط© ط§ظ„ط¥ط¹ط¯ط§ط¯ظٹط©', grade: s.grade_level, section: 'ط£', fees: 500000, paid: isPaid ? 500000 : 150000, status: isPaid ? 'ظ…ط³ط¯ط¯' : 'ظ…طھط¹ط«ط±'});
            if (isPaid) {
                DB.receipts.push({id: i+1, number: `REC-${String(i+1).padStart(3,'0')}`, date: '2025-09-15', studentName: s.full_name, amount: 500000, method: 'ظ†ظ‚ط¯ط§ظ‹'});
            }
        });
        nextId.enrollment = DB.enrollment.length + 1;
        nextId.receipts = DB.receipts.length + 1;
    } catch(e) { console.error(e); }
}

// ==================== ط§ظ„طھظ†ظ‚ظ„ ====================
let history = ['pg-home-menu'];
function goTo(id) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    const pg = document.getElementById(id); if (pg) pg.classList.add('active');
    
    let t = id.replace('pg-','');
    const btn = document.querySelector(`.mega-btn[onclick="goTo('${id}')"]`);
    if(btn) t = btn.textContent.trim();
    if(id === 'pg-dashboard') t = 'ظ„ظˆط­ط© ط§ظ„طھط­ظƒظ… ط§ظ„ط±ط¦ظٹط³ظٹط©';
    if(id === 'pg-home-menu') t = 'ط§ظ„ظ‚ط§ط¦ظ…ط© ط§ظ„ط±ط¦ظٹط³ظٹط©';

    document.getElementById('breadcrumb').innerHTML = `<i class="fa-solid fa-house" onclick="goTo('pg-home-menu')" style="cursor:pointer"></i> / ${t}`;
    
    if (history[history.length-1] !== id) history.push(id);
    if (id === 'pg-dashboard') renderDashboard();
    if (id === 'pg-attendance') initAttendance();
    if (id === 'pg-student-tree') renderStudentTree();
    if (id === 'pg-finance-reports') renderFinanceReport();
    if (id === 'pg-grading') initGrading();
}

// Sidebar Navigation
document.querySelectorAll('.nav-item').forEach(n => n.addEventListener('click', e => { 
    if(n.dataset.target) { e.preventDefault(); goTo(n.dataset.target); }
}));
document.querySelectorAll('.nav-group-toggle').forEach(btn => btn.addEventListener('click', () => btn.closest('.nav-group').classList.toggle('open')));
document.getElementById('mobileMenuBtn')?.addEventListener('click', () => document.querySelector('.sidebar').classList.toggle('open'));
document.getElementById('sidebarCloseBtn')?.addEventListener('click', () => document.querySelector('.sidebar').classList.remove('open'));

// Mega Menu Navigation (Keep if still used elsewhere)
document.querySelectorAll('.mega-header').forEach(header => {
    header.addEventListener('click', () => {
        const group = header.closest('.mega-group');
        if (group) {
            document.querySelectorAll('.mega-group').forEach(g => {
                if(g !== group) g.classList.remove('open');
            });
            group.classList.toggle('open');
        }
    });
});


  // ==================== (Render) ====================
function render(type) {
    const renderers = { stages: renderStages, sections: renderSections, students: renderStudents, users: renderUsers, employees: renderEmployees, subjects: renderSubjects, enrollment: renderEnrollment, receipts: renderReceipts, audit: renderAudit, grading: renderGrading, results: renderResults, cashboxes: renderCashboxes, vreceipts: renderVReceipts, vpayments: renderVPayments, journal: renderJournal, substitute: renderSubstitute, contracts: renderContracts, advances: renderAdvances, activities: renderActivities, transport: renderTransport };
    if (renderers[type]) renderers[type]();
}
function refreshAll() {
    render('stages'); render('sections'); render('students'); render('users'); render('employees'); render('subjects');
    render('enrollment'); render('receipts'); render('audit'); render('grading'); render('results');
    render('cashboxes'); render('vreceipts'); render('vpayments'); render('journal'); render('substitute');
    render('contracts'); render('advances'); render('activities'); render('transport');
    if (document.getElementById('pg-dashboard').classList.contains('active')) renderDashboard();
}

let financeChart = null;
function renderDashboard() {
    // 1. ط§ظ„ط£ط±ظ‚ط§ظ…
    if(document.getElementById('dTotalStudents')) document.getElementById('dTotalStudents').textContent = DB.students.length;
    if(document.getElementById('dTotalEmp')) document.getElementById('dTotalEmp').textContent = DB.employees.length;
    if(document.getElementById('dSubjects')) document.getElementById('dSubjects').textContent = DB.subjects.length;
    if(document.getElementById('dStages')) document.getElementById('dStages').textContent = [...new Set(DB.stages.map(s=>s.stage))].length;
    
    let paidCount = DB.students.filter(e => e.financial_status === 'ظ…ط³ط¯ط¯').length;
    let unpaidCount = DB.students.filter(e => e.financial_status !== 'ظ…ط³ط¯ط¯').length;
    if(document.getElementById('dPaid')) document.getElementById('dPaid').textContent = paidCount;
    if(document.getElementById('dUnpaid')) document.getElementById('dUnpaid').textContent = unpaidCount;
    
    // 2. ط³ط¬ظ„ ط§ظ„ط­ط±ظƒط§طھ
    const al = document.getElementById('auditLogList');
    if (al) {
        al.innerHTML = '';
        const recent = [...DB.audit].reverse().slice(0, 10);
        if (recent.length === 0) al.innerHTML = '<p style="color:var(--muted);text-align:center">ظ„ط§ ظٹظˆط¬ط¯ ط­ط±ظƒط§طھ ط¨ط¹ط¯.</p>';
        recent.forEach(r => {
            al.innerHTML += `<div style="padding:10px;border-bottom:1px solid var(--border);font-size:0.9rem">
                <div style="color:var(--primary);font-weight:700;margin-bottom:4px"><i class="fa-solid fa-user-shield"></i> ${r.user} <span style="float:left;color:var(--muted);font-weight:normal;font-size:0.8rem">${r.time}</span></div>
                <div style="color:var(--text)"><span class="badge" style="background:var(--bg);color:var(--text);border:1px solid var(--border)">${r.action}</span> ${r.details}</div>
            </div>`;
        });
    }
    
    // 3. ط§ظ„ط±ط³ظ… ط§ظ„ط¨ظٹط§ظ†ظٹ ط§ظ„ظ…ط§ظ„ظٹ
    const ctx = document.getElementById('financeChart');
    if (!ctx) return;
    
    let totalRevenues = DB.receipts.reduce((sum, r) => sum + r.amount, 0) + DB.vreceipts.reduce((sum, r) => sum + r.amount, 0);
    let totalExpenses = DB.vpayments.reduce((sum, p) => sum + p.amount, 0);
    let totalPayroll = DB.journal.filter(j => j.desc.includes('ط±ظˆط§طھط¨')).reduce((sum, j) => sum + j.debit, 0);
    totalExpenses += totalPayroll;

    if (financeChart) financeChart.destroy();
    
    financeChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['ط§ظ„ط¥ظٹط±ط§ط¯ط§طھ', 'ط§ظ„ظ…طµط±ظˆظپط§طھ'],
            datasets: [{
                data: [totalRevenues, totalExpenses],
                backgroundColor: ['#10b981', '#ef4444'],
                borderWidth: 0,
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { color: getComputedStyle(document.body).getPropertyValue('--text') } }
            }
        }
    });
}

function renderStages() {
    const q = (document.getElementById('searchStages')?.value||'').toLowerCase(), tb = document.getElementById('tbl-stages');
    tb.innerHTML = ''; DB.stages.filter(s => s.stage.includes(q)||s.grade.includes(q)).forEach(s => {
        tb.innerHTML += `<tr><td>${s.stage}</td><td>${s.grade}</td><td>${s.order}</td><td><div class="act"><button class="btn-edit" onclick="editItem('stage',${s.id})"><i class="fa-solid fa-pen"></i></button><button class="btn-delete" onclick="delItem('stage',${s.id},'${s.grade}')"><i class="fa-solid fa-trash"></i></button></div></td></tr>`;
    });
}
function renderSections() {
    const q = (document.getElementById('searchSections')?.value||'').toLowerCase(), tb = document.getElementById('tbl-sections');
