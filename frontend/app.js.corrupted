}
function saveEmpAttendance() {
    const date = document.getElementById('empAttDate')?.value;
    if (!date) return toast('âڑ ï¸ڈ ظٹط±ط¬ظ‰ طھط­ط¯ظٹط¯ ط§ظ„طھط§ط±ظٹط®',1);
    
    document.querySelectorAll('.att-status').forEach(sel => {
        const emp = sel.dataset.emp, status = sel.value;
        const timeIn = document.querySelector(`.att-in[data-emp="${emp}"]`).value;
        const timeOut = document.querySelector(`.att-out[data-emp="${emp}"]`).value;
        
        let a = DB.empAttendance.find(x => x.date === date && x.empName === emp);
        if (!a) { a = {id:nextId.empAtt++, date, empName:emp}; DB.empAttendance.push(a); }
        a.timeIn = timeIn; a.timeOut = timeOut; a.status = status;
    });
    addAudit('ظ…ظˆط¸ظپظٹظ†', `ط­ظپط¸ ط­ط¶ظˆط± ط§ظ„ظ…ظˆط¸ظپظٹظ† ظ„ظٹظˆظ… ${date}`);
    toast('طھظ… ط­ظپط¸ ط§ظ„ط­ط¶ظˆط± ط¨ظ†ط¬ط§ط­ âœ…');
}

function renderAdvances() {
    const q = (document.getElementById('searchAdvances')?.value||'').toLowerCase(), tb = document.getElementById('tbl-advances');
    tb.innerHTML = '';
