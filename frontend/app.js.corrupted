        if (a.type === 'ط±ظٹط§ط¶ظٹ') typeIcon = '<i class="fa-solid fa-futbol text-green-500"></i>';
        if (a.type === 'ط«ظ‚ط§ظپظٹ') typeIcon = '<i class="fa-solid fa-book-open text-purple-500"></i>';
        
        tb.innerHTML += `<tr><td>${a.name}</td><td>${typeIcon} ${a.type}</td><td>${a.supervisor}</td><td>${a.date}</td><td><span style="font-weight:700">${a.participants}</span> ط·ط§ظ„ط¨</td><td><div class="act"><button class="btn-edit" onclick="editItem('activity',${a.id})"><i class="fa-solid fa-pen"></i></button><button class="btn-delete" onclick="delItem('activity',${a.id},'${a.name}')"><i class="fa-solid fa-trash"></i></button></div></td></tr>`;
