}

function updateSubjectOptions(stageSelect, selectedName = null) {
    const stageType = stageSelect.options[stageSelect.selectedIndex]?.dataset.stage || '';
    const nameSelect = document.getElementById('f_name');
    let subjects = [];
    if (stageType.includes('ط§ط¨طھط¯ط§ط¦ظٹ')) subjects = ['ط§ظ„ظ‚ط±ط¢ظ† ط§ظ„ظƒط±ظٹظ…', 'ط§ظ„طھط±ط¨ظٹط© ط§ظ„ط¥ط³ظ„ط§ظ…ظٹط©', 'ط§ظ„ظ„ط؛ط© ط§ظ„ط¹ط±ط¨ظٹط©', 'ط§ظ„ط±ظٹط§ط¶ظٹط§طھ', 'ط§ظ„ط¹ظ„ظˆظ…', 'ط§ظ„طھط±ط¨ظٹط© ط§ظ„ظپظ†ظٹط©'];
    else if (stageType.includes('ط¥ط¹ط¯ط§ط¯ظٹ') || stageType.includes('ظ…طھظˆط³ط·')) subjects = ['ط§ظ„ظ‚ط±ط¢ظ† ط§ظ„ظƒط±ظٹظ…', 'ط§ظ„طھط±ط¨ظٹط© ط§ظ„ط¥ط³ظ„ط§ظ…ظٹط©', 'ط§ظ„ظ„ط؛ط© ط§ظ„ط¹ط±ط¨ظٹط©', 'ط§ظ„ط±ظٹط§ط¶ظٹط§طھ', 'ط§ظ„ط¹ظ„ظˆظ…', 'ط§ظ„ظ„ط؛ط© ط§ظ„ط¥ظ†ط¬ظ„ظٹط²ظٹط©', 'ط§ظ„ط§ط¬طھظ…ط§ط¹ظٹط§طھ', 'ط§ظ„ط­ط§ط³ظˆط¨'];
    else if (stageType.includes('ط«ط§ظ†ظˆظٹ')) subjects = ['ط§ظ„ظ‚ط±ط¢ظ† ط§ظ„ظƒط±ظٹظ…', 'ط§ظ„طھط±ط¨ظٹط© ط§ظ„ط¥ط³ظ„ط§ظ…ظٹط©', 'ط§ظ„ظ„ط؛ط© ط§ظ„ط¹ط±ط¨ظٹط©', 'ط§ظ„ط±ظٹط§ط¶ظٹط§طھ', 'ط§ظ„ظپظٹط²ظٹط§ط،', 'ط§ظ„ظƒظٹظ…ظٹط§ط،', 'ط§ظ„ط£ط­ظٹط§ط،', 'ط§ظ„ظ„ط؛ط© ط§ظ„ط¥ظ†ط¬ظ„ظٹط²ظٹط©', 'ط§ظ„ط­ط§ط³ظˆط¨'];
    else subjects = ['ظ…ط§ط¯ط© ط¹ط§ظ…ط©'];
    
    nameSelect.innerHTML = subjects.map(s => `<option ${s === selectedName ? 'selected' : ''}>${s}</option>`).join('');
}

function editItem(type, id) { openForm(type, id); }

// ==================== ط­ظپط¸ ط§ظ„ظ†ظ…ط§ط°ط¬ ====================
function saveForm() {
    if (formType === 'school') {
        const name = gv('f_name');
        if (!name) return toast('ظٹط±ط¬ظ‰ ط¥ط¯ط®ط§ظ„ ط§ط³ظ… ط§ظ„ظ…ط¯ط±ط³ط©', 1);
        const o = {
            name: name, gov: gv('f_gov'), loc: gv('f_loc'), center: gv('f_center'),
            entity: gv('f_entity'), capital: gv('f_capital'), cr_num: gv('f_cr_num'),
            building_info: gv('f_building_info'), owner: gv('f_owner'),
            prin: gv('f_prin'), prin_ph: gv('f_prin_ph'),
            status: 'ظ†ط´ط·', subscriptionEnd: '2027-01-01', usersCount: 0
        };
        if (formEditId) {
            const i = DB.schools.findIndex(s=>s.id===formEditId);
            if (i >= 0) Object.assign(DB.schools[i], o);
        } else {
            o.id = nextId.schools++;
            DB.schools.push(o);
        }
        renderSchools();
        toast('طھظ… ط­ظپط¸ ط¨ظٹط§ظ†ط§طھ ط§ظ„ظ…ط¯ط±ط³ط© ط¨ظ†ط¬ط§ط­');
    } else if (formType === 'stage') {
        const o = {stage: gv('f_stage'), grade: gv('f_grade'), order: parseInt(gv('f_order'))||1};
        if (!o.grade) return toast('âڑ ï¸ڈ ط§ط³ظ… ط§ظ„طµظپ ظ…ط·ظ„ظˆط¨',1);
        if (formEditId) { const i = DB.stages.findIndex(s=>s.id===formEditId); if(i>=0) Object.assign(DB.stages[i],o); addAudit('طھط¹ط¯ظٹظ„','طھط¹ط¯ظٹظ„ طµظپ: '+o.grade); }
        else { o.id = nextId.stages++; DB.stages.push(o); addAudit('ط¥ط¶ط§ظپط©','ط¥ط¶ط§ظپط© طµظپ: '+o.grade); }
        render('stages');
    } else if (formType === 'section') {
        const sel = document.getElementById('f_grade'), opt = sel.selectedOptions[0];
        const o = {name: gv('f_name'), grade: sel.value, stage: opt.dataset.stage, capacity: parseInt(gv('f_cap'))||40};
        if (!o.name) return toast('âڑ ï¸ڈ ط§ط³ظ… ط§ظ„ط´ط¹ط¨ط© ظ…ط·ظ„ظˆط¨',1);
        if (formEditId) { const i = DB.sections.findIndex(s=>s.id===formEditId); if(i>=0) Object.assign(DB.sections[i],o); addAudit('طھط¹ط¯ظٹظ„','طھط¹ط¯ظٹظ„ ط´ط¹ط¨ط©: '+o.name); }
        else { o.id = nextId.sections++; DB.sections.push(o); addAudit('ط¥ط¶ط§ظپط©','ط¥ط¶ط§ظپط© ط´ط¹ط¨ط©: '+o.name); }
        render('sections');
    } else if (formType === 'student') {
        const name = gv('f_name'), num = gv('f_num'), ph1 = gv('f_ph1'), email = gv('f_email'), gender = gv('f_gender'), nid = gv('f_nid'), dob = gv('f_dob');
        if (name.split(/\s+/).filter(p=>p).length < 4) return toast('âڑ ï¸ڈ ظٹط¬ط¨ ظƒطھط§ط¨ط© ط§ظ„ط§ط³ظ… ط§ظ„ط±ط¨ط§ط¹ظٹ',1);
        if (!num) return toast('âڑ ï¸ڈ ط±ظ‚ظ… ط§ظ„ط·ط§ظ„ط¨ ظ…ط·ظ„ظˆط¨',1);
        if (!ph1 || !/^7\d{8}$/.test(ph1)) return toast('âڑ ï¸ڈ ط±ظ‚ظ… ظˆظ„ظٹ ط§ظ„ط£ظ…ط± 1 ظٹط¬ط¨ 9 ط£ط±ظ‚ط§ظ… ظٹط¨ط¯ط£ ط¨ظ€ 7',1);
        if (!dob) return toast('âڑ ï¸ڈ طھط§ط±ظٹط® ط§ظ„ظ…ظٹظ„ط§ط¯ ظ…ط·ظ„ظˆط¨',1);
        if (!gender) return toast('âڑ ï¸ڈ ط§ط®طھط± ط§ظ„ط¬ظ†ط³',1);
        if (!nid) return toast('âڑ ï¸ڈ ط§ظ„ط±ظ‚ظ… ط§ظ„ظˆط·ظ†ظٹ ظ…ط·ظ„ظˆط¨',1);
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return toast('âڑ ï¸ڈ ط¨ط±ظٹط¯ ط¥ظ„ظƒطھط±ظˆظ†ظٹ طµط­ظٹط­ ظ…ط·ظ„ظˆط¨',1);
        const o = {full_name:name, student_number:num, grade_level:gv('f_level'), phone1:ph1, phone2:gv('f_ph2'), dob, pob:gv('f_pob'), residence:gv('f_res'), natid:nid, gender, nationality:gv('f_nat'), email, financial_status:'ظ…ط³ط¯ط¯'};
        if (formEditId) { const i = DB.students.findIndex(s=>s.id===formEditId); if(i>=0) Object.assign(DB.students[i],o); addAudit('طھط¹ط¯ظٹظ„','طھط¹ط¯ظٹظ„ ط·ط§ظ„ط¨: '+name); }
        else { o.id = 'local-'+Date.now(); DB.students.push(o); addAudit('ط¥ط¶ط§ظپط©','طھط³ط¬ظٹظ„ ط·ط§ظ„ط¨: '+name); }
        render('students'); refreshAll();
    } else if (formType === 'user') {
        const o = {username: gv('f_uname'), role: gv('f_role'), status: 'ظ†ط´ط·'};
        if (!o.username) return toast('âڑ ï¸ڈ ط§ط³ظ… ط§ظ„ظ…ط³طھط®ط¯ظ… ظ…ط·ظ„ظˆط¨',1);
        if (formEditId) { const i = DB.users.findIndex(u=>u.id===formEditId); if(i>=0) Object.assign(DB.users[i],o); addAudit('طھط¹ط¯ظٹظ„','طھط¹ط¯ظٹظ„ ظ…ط³طھط®ط¯ظ…: '+o.username); }
        else { o.id = nextId.users++; DB.users.push(o); addAudit('ط¥ط¶ط§ظپط©','ط¥ط¶ط§ظپط© ظ…ط³طھط®ط¯ظ…: '+o.username); }
        render('users');
    } else if (formType === 'employee') {
        const o = {name:gv('f_name'), job:gv('f_job'), phone:gv('f_phone'), specialty:gv('f_spec'), status:gv('f_status')};
        if (!o.name) return toast('âڑ ï¸ڈ ط§ط³ظ… ط§ظ„ظ…ظˆط¸ظپ ظ…ط·ظ„ظˆط¨',1);
        if (formEditId) { const i = DB.employees.findIndex(e=>e.id===formEditId); if(i>=0) Object.assign(DB.employees[i],o); addAudit('طھط¹ط¯ظٹظ„','طھط¹ط¯ظٹظ„ ظ…ظˆط¸ظپ: '+o.name); }
        else { o.id = nextId.employees++; DB.employees.push(o); addAudit('ط¥ط¶ط§ظپط©','ط¥ط¶ط§ظپط© ظ…ظˆط¸ظپ: '+o.name); }
        render('employees'); refreshAll();
    } else if (formType === 'subject') {
        const o = {code:gv('f_code'), name:gv('f_name'), stage:gv('f_stage'), maxScore:parseInt(gv('f_max'))||100, minScore:parseInt(gv('f_min'))||50};
        if (!o.name) return toast('âڑ ï¸ڈ ط§ط³ظ… ط§ظ„ظ…ط§ط¯ط© ظ…ط·ظ„ظˆط¨',1);
        if (formEditId) { const i = DB.subjects.findIndex(s=>s.id===formEditId); if(i>=0) Object.assign(DB.subjects[i],o); addAudit('طھط¹ط¯ظٹظ„','طھط¹ط¯ظٹظ„ ظ…ط§ط¯ط©: '+o.name); }
        else { o.id = nextId.subjects++; DB.subjects.push(o); addAudit('ط¥ط¶ط§ظپط©','ط¥ط¶ط§ظپط© ظ…ط§ط¯ط©: '+o.name); }
        render('subjects'); refreshAll();
    } else if (formType === 'enrollment') {
        const o = {studentName:gv('f_stu'), year:gv('f_year'), grade:gv('f_grade'), stage:'ط§ظ„ظ…ط±ط­ظ„ط© ط§ظ„ط¥ط¹ط¯ط§ط¯ظٹط©', section:gv('f_sec'), fees:parseInt(gv('f_fees'))||500000, paid:0, status:'ظ…طھط¹ط«ط±'};
        if (formEditId) { const i = DB.enrollment.findIndex(e=>e.id===formEditId); if(i>=0) Object.assign(DB.enrollment[i],o); addAudit('طھط¹ط¯ظٹظ„','طھط¹ط¯ظٹظ„ طھط³ط¬ظٹظ„: '+o.studentName); }
        else { o.id = nextId.enrollment++; DB.enrollment.push(o); addAudit('طھط³ط¬ظٹظ„','طھط³ط¬ظٹظ„ ط·ط§ظ„ط¨ ظپظٹ ط³ظ†ط©: '+o.studentName); }
        render('enrollment');
    } else if (formType === 'receipt') {
        const amt = parseInt(gv('f_amount'));
        if (!amt || amt <= 0) return toast('âڑ ï¸ڈ ط£ط¯ط®ظ„ ظ…ط¨ظ„ط؛ طµط­ظٹط­',1);
        if (formEditId) {
            const i = DB.receipts.findIndex(r=>r.id===formEditId);
            if (i>=0) {
                DB.receipts[i].amount = amt;
                DB.receipts[i].studentName = gv('f_stu');
                DB.receipts[i].method = gv('f_method');
                DB.receipts[i].notes = gv('f_notes');
            }
        } else {
            const o = {id:nextId.receipts++, number:`REC-${String(nextId.receipts).padStart(3,'0')}`, date:new Date().toLocaleDateString('en-CA'), studentName:gv('f_stu'), amount:amt, method:gv('f_method'), notes:gv('f_notes')};
            DB.receipts.push(o); addAudit('ط³ظ†ط¯ ظ‚ط¨ط¶',`ط³ظ†ط¯ ظ‚ط¨ط¶ ${o.number} - ${o.studentName} - ${amt.toLocaleString()} ط±ظٹط§ظ„`);
        }
        recalcEnrollments();
        render('receipts'); render('enrollment');
    }
    closeModal('formModal');
    toast(formEditId ? 'طھظ… ط§ظ„طھط¹ط¯ظٹظ„ ط¨ظ†ط¬ط§ط­ âœ…' : 'طھظ…طھ ط§ظ„ط¥ط¶ط§ظپط© ط¨ظ†ط¬ط§ط­ âœ…');
}

// ==================== ط§ظ„ط­ط°ظپ ====================
let delType = null, delId = null;
function delItem(type, id, name) { delType=type; delId=id; document.getElementById('deleteMessage').textContent=`ظ‡ظ„ ط£ظ†طھ ظ…طھط£ظƒط¯ ظ…ظ† ط­ط°ظپ "${name}"طں`; document.getElementById('deleteModal').classList.add('active'); }
function confirmDel() {
    if (delType === 'school') { DB.schools = DB.schools.filter(s=>s.id!==delId); renderSchools(); addAudit('ط­ط°ظپ','ط­ط°ظپ ظ…ط¯ط±ط³ط©'); closeModal('deleteModal'); toast('طھظ… ط§ظ„ط­ط°ظپ ط¨ظ†ط¬ط§ط­'); return; }
    if (delType === 'substitute') { DB.substitutes = DB.substitutes.filter(s=>s.id!==delId); render('substitute'); addAudit('ط­ط°ظپ','ط­ط°ظپ ط¨ط¯ظٹظ„'); closeModal('deleteModal'); toast('طھظ… ط§ظ„ط­ط°ظپ ط¨ظ†ط¬ط§ط­'); return; }
    if (delType === 'contract') { DB.contracts = DB.contracts.filter(c=>c.id!==delId); render('contracts'); addAudit('ط­ط°ظپ','ط­ط°ظپ ط¹ظ‚ط¯ ظ…ظˆط¸ظپ'); closeModal('deleteModal'); toast('طھظ… ط§ظ„ط­ط°ظپ ًں—‘ï¸ڈ'); return; }
    if (delType === 'advance') { DB.advances = DB.advances.filter(a=>a.id!==delId); render('advances'); addAudit('ط­ط°ظپ','ط­ط°ظپ ط³ظ„ظپط©'); closeModal('deleteModal'); toast('طھظ… ط§ظ„ط­ط°ظپ ًں—‘ï¸ڈ'); return; }
    if (delType === 'activity') { DB.activities = DB.activities.filter(a=>a.id!==delId); render('activities'); addAudit('ط­ط°ظپ','ط­ط°ظپ ظ†ط´ط§ط·'); closeModal('deleteModal'); toast('طھظ… ط§ظ„ط­ط°ظپ ًں—‘ï¸ڈ'); return; }
    if (delType === 'transport') { DB.transport = DB.transport.filter(t=>t.id!==delId); render('transport'); addAudit('ط­ط°ظپ','ط­ط°ظپ ط®ط· ط³ظٹط±'); closeModal('deleteModal'); toast('طھظ… ط§ظ„ط­ط°ظپ ًں—‘ï¸ڈ'); return; }
    if (delType === 'receipt') { DB.receipts = DB.receipts.filter(r=>r.id!==delId); recalcEnrollments(); render('receipts'); render('enrollment'); addAudit('ط­ط°ظپ','ط­ط°ظپ ط³ظ†ط¯ ظ‚ط¨ط¶'); closeModal('deleteModal'); toast('طھظ… ط§ظ„ط­ط°ظپ ًں—‘ï¸ڈ'); return; }
    const map = {stage:'stages',section:'sections',student:'students',user:'users',employee:'employees',subject:'subjects'};
    const key = map[delType];
    if (key) { DB[key] = DB[key].filter(i => i.id !== delId); render(key.replace(/s$/,'')||key); addAudit('ط­ط°ظپ',`ط­ط°ظپ ظ…ظ† ${key}`); refreshAll(); }
    closeModal('deleteModal'); toast('طھظ… ط§ظ„ط­ط°ظپ ًں—‘ï¸ڈ');
}

function recalcEnrollments() {
    DB.enrollment.forEach(e => {
        const recs = DB.receipts.filter(r => r.studentName === e.studentName);
        e.paid = recs.reduce((sum, r) => sum + r.amount, 0);
        e.status = e.paid >= e.fees ? 'ظ…ط³ط¯ط¯' : 'ظ…طھط¹ط«ط±';
    });
}

// ==================== ط§ظ„طھظ‚ط±ظٹط± ====================
async function viewReport(sid) {
    document.getElementById('reportModal').classList.add('active');
    document.getElementById('rptTitle').textContent = 'ط¬ط§ط±ظٹ ط§ظ„طھط­ظ…ظٹظ„...';
    document.getElementById('rptBody').innerHTML = '<p style="text-align:center;color:var(--muted)">ط¬ط§ط±ظٹ ط§ظ„ط¬ظ„ط¨...</p>';
    try {
        const r = await fetch(`${API}/finance/dashboard/student/${sid}`, {headers:{'Authorization':`Bearer ${token}`}});
        const d = await r.json(), s = d.student;
        document.getElementById('rptTitle').textContent = `ط§ظ„طھظ‚ط±ظٹط±: ${s.full_name}`;
        let html = `<div class="s-info"><div><span class="lbl">ط§ظ„ط§ط³ظ…</span>${s.full_name}</div><div><span class="lbl">ط§ظ„ط±ظ‚ظ…</span>${s.student_number}</div><div><span class="lbl">ط§ظ„طµظپ</span>${s.grade_level}</div><div><span class="lbl">ط§ظ„ظ…ظٹظ„ط§ط¯</span>${s.date_of_birth}</div><div><span class="lbl">ط§ظ„ط¬ظ†ط³</span>${s.gender}</div><div><span class="lbl">ط§ظ„ط¬ظ†ط³ظٹط©</span>${s.nationality}</div></div>`;
        const fin = d.financial;
        if (fin.payment_status && fin.payment_status.toLowerCase() !== 'paid') html += `<div class="alert danger"><i class="fa-solid fa-triangle-exclamation"></i> ${d.financial_message} (ط¨ط§ظ‚ظٹ: ${fin.remaining?.toLocaleString()} ط±ظٹط§ظ„)</div>`;
        else html += `<div class="alert success"><i class="fa-solid fa-circle-check"></i> ${d.financial_message}</div>`;
        if (d.blockchain_verified) html += `<div class="alert success"><i class="fa-solid fa-shield-halved"></i> ط§ظ„ط¨ظ„ظˆظƒط´ظٹظ†: طھظ… ط§ظ„طھط­ظ‚ظ‚ âœ…</div>`;
        html += '<h4 style="margin:14px 0 8px;color:var(--muted)"><i class="fa-solid fa-graduation-cap"></i> ط§ظ„ط¯ط±ط¬ط§طھ</h4>';
        d.grades.forEach(g => { html += `<div class="grade-row"><div><strong>${g.subject}</strong><br><span style="font-size:.65rem;color:var(--muted);font-family:monospace">${g.hash}</span></div><span class="grade-score">${g.score}</span></div>`; });
        document.getElementById('rptBody').innerHTML = html;
    } catch(e) { document.getElementById('rptTitle').textContent = 'ط®ط·ط£'; }
}

// ==================== ط§ظ„ط­ط¶ظˆط± ====================
function initAttendance() {
    const sel = document.getElementById('attStage');
    sel.innerHTML = '<option value="">ظƒظ„ ط§ظ„طµظپظˆظپ</option>' + DB.stages.map(s=>`<option>${s.grade}</option>`).join('');
    document.getElementById('attDate').value = new Date().toLocaleDateString('en-CA');
    render('attendance');
}
function renderAttendance() { // called via render('attendance')
    const grade = document.getElementById('attStage')?.value||'', tb = document.getElementById('tbl-attendance');
    tb.innerHTML = '';
    DB.students.filter(s => !grade || s.grade_level === grade).forEach(s => {
        const existing = DB.attendance.find(a => a.sid === s.id && a.date === document.getElementById('attDate').value);
        const st = existing ? existing.status : 'ط­ط§ط¶ط±';
        tb.innerHTML += `<tr><td>${s.student_number}</td><td>${s.full_name}</td><td>${s.grade_level}</td><td><select class="att-select" data-sid="${s.id}"><option ${st==='ط­ط§ط¶ط±'?'selected':''}>ط­ط§ط¶ط±</option><option ${st==='ط؛ط§ط¦ط¨'?'selected':''}>ط؛ط§ط¦ط¨</option><option ${st==='ظ…طھط£ط®ط±'?'selected':''}>ظ…طھط£ط®ط±</option><option ${st==='ظ…ط¹ط°ظˆط±'?'selected':''}>ظ…ط¹ط°ظˆط±</option></select></td></tr>`;
    });
}
// Override render for attendance
const origRender = render;
render = function(t) { if (t==='attendance') renderAttendance(); else origRender(t); };

function saveAttendance() {
    const date = document.getElementById('attDate').value;
    document.querySelectorAll('.att-select').forEach(sel => {
        const sid = sel.dataset.sid, existing = DB.attendance.findIndex(a => a.sid===sid && a.date===date);
        if (existing >= 0) DB.attendance[existing].status = sel.value;
        else DB.attendance.push({sid, date, status: sel.value});
    });
    addAudit('ط­ط¶ظˆط±','طھط³ط¬ظٹظ„ ط­ط¶ظˆط± ظٹظˆظ… '+date);
    toast('طھظ… ط­ظپط¸ ط§ظ„ط­ط¶ظˆط± âœ…');
}

// ==================== ظƒط´ظپ ط­ط³ط§ط¨ ط·ط§ظ„ط¨ ====================
function initStudentAccount() {
    const selGrade = document.getElementById('accGrade');
    selGrade.innerHTML = '<option value="">-- ظƒظ„ ط§ظ„طµظپظˆظپ --</option>' + DB.stages.map(s => `<option value="${s.grade}">${s.grade}</option>`).join('');
    initStudentAccountStudents();
}
function initStudentAccountStudents(query = '') {
    const grade = document.getElementById('accGrade').value;
    const selStu = document.getElementById('accStudent');
    const filtered = DB.students.filter(s => (!grade || s.grade_level === grade) && s.full_name.includes(query));
    selStu.innerHTML = '<option value="">-- ط§ط®طھط± ط§ظ„ط·ط§ظ„ط¨ --</option>' + filtered.map(s => `<option value="${s.id}">${s.full_name}</option>`).join('');
    renderStudentAccount();
}
function renderStudentAccount() {
    const sid = document.getElementById('accStudent').value, div = document.getElementById('studentAccountView');
    if (!sid) { div.innerHTML = ''; return; }
    const stu = DB.students.find(s=>s.id===sid);
    const enr = DB.enrollment.find(e=>e.studentName===stu?.full_name);
    const recs = DB.receipts.filter(r=>r.studentName===stu?.full_name);
    let html = `<div class="s-info"><div><span class="lbl">ط§ظ„ط·ط§ظ„ط¨</span>${stu.full_name}</div><div><span class="lbl">ط§ظ„طµظپ</span>${stu.grade_level}</div></div>`;
    if (enr) {
        html += `<div class="stats-row"><div class="stat-card c-blue"><i class="fa-solid fa-money-bill"></i><div><span class="stat-number">${enr.fees.toLocaleString()}</span><span class="stat-label">ط§ظ„ط±ط³ظˆظ… ط§ظ„ظ…ط·ظ„ظˆط¨ط©</span></div></div><div class="stat-card c-green"><i class="fa-solid fa-check"></i><div><span class="stat-number">${enr.paid.toLocaleString()}</span><span class="stat-label">ط§ظ„ظ…ط³ط¯ط¯</span></div></div><div class="stat-card c-red"><i class="fa-solid fa-xmark"></i><div><span class="stat-number">${(enr.fees-enr.paid).toLocaleString()}</span><span class="stat-label">ط§ظ„ظ…طھط¨ظ‚ظٹ</span></div></div></div>`;
    }
    if (recs.length) {
        html += '<h4 style="margin:14px 0 8px;color:var(--muted)"><i class="fa-solid fa-receipt"></i> ط³ظ†ط¯ط§طھ ط§ظ„ظ‚ط¨ط¶</h4><div class="table-wrapper"><table><thead><tr><th>ط§ظ„ط±ظ‚ظ…</th><th>ط§ظ„طھط§ط±ظٹط®</th><th>ط§ظ„ظ…ط¨ظ„ط؛</th><th>ط§ظ„ط·ط±ظٹظ‚ط©</th></tr></thead><tbody>';
        recs.forEach(r => { html += `<tr><td>${r.number}</td><td>${r.date}</td><td>${r.amount.toLocaleString()}</td><td>${r.method}</td></tr>`; });
        html += '</tbody></table></div>';
    }
    div.innerHTML = html;
}

// ==================== ط§ظ„طھظ‚ط§ط±ظٹط± ط§ظ„ظ…ط§ظ„ظٹط© ====================
function renderFinanceReport() {
    let totalRev=0, totalDebt=0;
    const tb = document.getElementById('tbl-finance-report');
    tb.innerHTML = '';
    DB.enrollment.forEach(e => {
        totalRev += e.paid; totalDebt += (e.fees - e.paid);
        const sc = e.status==='ظ…ط³ط¯ط¯'?'status-paid':'status-unpaid';
        tb.innerHTML += `<tr><td>${e.studentName}</td><td>${e.stage}</td><td>${e.fees.toLocaleString()}</td><td>${e.paid.toLocaleString()}</td><td>${(e.fees-e.paid).toLocaleString()}</td><td class="${sc}">${e.status}</td></tr>`;
    });
    document.getElementById('frRevenue').textContent = totalRev.toLocaleString();
    document.getElementById('frDebt').textContent = totalDebt.toLocaleString();
}

// ==================== ط´ط¬ط±ط© ط§ظ„ط·ظ„ط§ط¨ ====================
function buildTree() {
    const c = document.getElementById('studentTree');
    const stageGroups = {};
    DB.stages.forEach(s => { if(!stageGroups[s.stage]) stageGroups[s.stage]=[]; stageGroups[s.stage].push(s.grade); });
    let html = '';
    for (const [stage, grades] of Object.entries(stageGroups)) {
        html += `<div class="tree-node"><div class="tree-label" onclick="this.parentElement.classList.toggle('open')"><i class="fa-solid fa-folder"></i> ${stage}</div><div class="tree-children">`;
        grades.forEach(g => {
            const stus = DB.students.filter(s=>s.grade_level===g);
            html += `<div class="tree-node"><div class="tree-label" onclick="this.parentElement.classList.toggle('open')"><i class="fa-solid fa-folder-open"></i> ${g} (${stus.length})</div><div class="tree-children">`;
            stus.forEach(s => { html += `<div class="tree-node"><div class="tree-label"><i class="fa-solid fa-user"></i> ${s.full_name}</div></div>`; });
            html += '</div></div>';
        });
        html += '</div></div>';
    }
    c.innerHTML = html || '<p style="color:var(--muted);text-align:center">ظ„ط§ طھظˆط¬ط¯ ط¨ظٹط§ظ†ط§طھ</p>';
}

// ==================== ط±طµط¯ ط§ظ„ط¯ط±ط¬ط§طھ ====================
function initGrading() {
    const ss = document.getElementById('grStage'), sb = document.getElementById('grSubject');
    ss.innerHTML = '<option value="">-- ط§ط®طھط± ط§ظ„طµظپ --</option>' + DB.stages.map(s=>`<option>${s.grade}</option>`).join('');
    sb.innerHTML = '<option value="">-- ط§ط®طھط± ط§ظ„ظ…ط§ط¯ط© --</option>';
    ss.onchange = () => {
        const stage = ss.value;
        sb.innerHTML = '<option value="">-- ط§ط®طھط± ط§ظ„ظ…ط§ط¯ط© --</option>' + DB.subjects.filter(s=>s.stage===stage).map(s=>`<option>${s.name}</option>`).join('');
        renderGrading();
    };
    renderGrading();
}
function renderGrading() {
    const grade = document.getElementById('grStage')?.value||'', subj = document.getElementById('grSubject')?.value||'', term = document.getElementById('grTerm')?.value||'ط§ظ„ظپطµظ„ ط§ظ„ط£ظˆظ„';
    const tb = document.getElementById('tbl-grading');
    tb.innerHTML = '';
    if (!grade || !subj) { tb.innerHTML='<tr><td colspan="7" style="text-align:center;color:var(--muted)">ظٹط±ط¬ظ‰ ط§ط®طھظٹط§ط± ط§ظ„طµظپ ظˆط§ظ„ظ…ط§ط¯ط©</td></tr>'; return; }
    
    DB.students.filter(s => s.grade_level===grade).forEach(s => {
        const g = DB.grades.find(x => x.sid===s.id && x.subj===subj && x.term===term) || {m1:0, m2:0, final:0, locked:false};
        const total = (parseInt(g.m1)||0)+(parseInt(g.m2)||0)+(parseInt(g.final)||0);
        const lockIcon = g.locked ? '<span style="color:var(--success)"><i class="fa-solid fa-shield-halved"></i> ظ…ط­ظ…ظٹ ط¨ط§ظ„ط¨ظ„ظˆظƒط´ظٹظ†</span>' : '<span style="color:var(--warning)"><i class="fa-solid fa-lock-open"></i> ظ…ط³ظˆط¯ط©</span>';
        const readonly = g.locked ? 'readonly disabled style="opacity:0.6"' : '';
        
        tb.innerHTML += `<tr>
            <td>${s.full_name}</td>
            <td>${s.grade_level}</td>
            <td><input type="number" class="gr-input m1" data-sid="${s.id}" value="${g.m1||''}" max="20" ${readonly}></td>
            <td><input type="number" class="gr-input m2" data-sid="${s.id}" value="${g.m2||''}" max="20" ${readonly}></td>
            <td><input type="number" class="gr-input final" data-sid="${s.id}" value="${g.final||''}" max="60" ${readonly}></td>
            <td style="font-weight:700">${total}</td>
            <td>${lockIcon}</td>
        </tr>`;
    });
}
function saveGrades() {
    const grade = document.getElementById('grStage')?.value||'', subj = document.getElementById('grSubject')?.value||'', term = document.getElementById('grTerm')?.value||'ط§ظ„ظپطµظ„ ط§ظ„ط£ظˆظ„';
    if (!grade || !subj) return toast('âڑ ï¸ڈ ظٹط±ط¬ظ‰ ط§ط®طھظٹط§ط± ط§ظ„طµظپ ظˆط§ظ„ظ…ط§ط¯ط©',1);
    
    const rows = document.querySelectorAll('#tbl-grading tr');
    if (!rows.length) return;
    
    document.querySelectorAll('.gr-input.m1').forEach(inp => {
        const sid = inp.dataset.sid;
        const m1 = parseInt(inp.value)||0;
        const m2 = parseInt(document.querySelector(`.gr-input.m2[data-sid="${sid}"]`).value)||0;
        const final = parseInt(document.querySelector(`.gr-input.final[data-sid="${sid}"]`).value)||0;
        
        let g = DB.grades.find(x => x.sid===sid && x.subj===subj && x.term===term);
        if (!g) { g = {id:'G-'+Date.now()+Math.random(), sid, subj, term}; DB.grades.push(g); }
        if (!g.locked) {
            g.m1 = m1; g.m2 = m2; g.final = final;
            g.total = m1+m2+final;
            g.locked = true; // Lock immediately on save to simulate blockchain commit
        }
    });
    addAudit('ظƒظ†طھط±ظˆظ„',`ط±طµط¯ ظˆطھط´ظپظٹط± ط¯ط±ط¬ط§طھ ${subj} - ${grade} - ${term}`);
    toast('طھظ… ط­ظپط¸ ط§ظ„ط¯ط±ط¬ط§طھ ظˆطھط´ظپظٹط±ظ‡ط§ ط¨ط§ظ„ط¨ظ„ظˆظƒط´ظٹظ† ًں›،ï¸ڈ');
    renderGrading();
}

// ==================== ظ†طھط§ط¦ط¬ ط§ظ„ط·ظ„ط§ط¨ ====================
function renderResults() {
    const q = (document.getElementById('searchResults')?.value||'').toLowerCase(), tb = document.getElementById('tbl-results');
    tb.innerHTML = '';
    
    // ط­ط³ط§ط¨ ظ†طھط§ط¦ط¬ ط§ظ„ط·ظ„ط§ط¨ ط§ظ„ظ…ط¬ظ…ط¹ط©
    const results = DB.students.filter(s => s.full_name.toLowerCase().includes(q)).map(s => {
        const sGrades = DB.grades.filter(g => g.sid === s.id);
        const totalScore = sGrades.reduce((sum, g) => sum + (g.total||0), 0);
        const maxPossible = sGrades.length * 100;
        const percent = maxPossible > 0 ? (totalScore / maxPossible * 100).toFixed(1) : 0;
        let rank = 'ظ…ظ…طھط§ط²'; if (percent < 90) rank = 'ط¬ظٹط¯ ط¬ط¯ط§ظ‹'; if (percent < 80) rank = 'ط¬ظٹط¯'; if (percent < 65) rank = 'ظ…ظ‚ط¨ظˆظ„'; if (percent < 50) rank = 'ط¶ط¹ظٹظپ';
        return { ...s, totalScore, maxPossible, percent, rank };
    }).sort((a,b) => b.totalScore - a.totalScore); // ظپط±ط² ط­ط³ط¨ ط§ظ„ظ…ط¬ظ…ظˆط¹ ظ„ظ„طھط±طھظٹط¨
    
    results.forEach((s, index) => {
        tb.innerHTML += `<tr>
            <td>${s.full_name}</td>
            <td>${s.grade_level}</td>
            <td style="font-weight:700">${s.totalScore} / ${s.maxPossible||0}</td>
            <td>${s.percent}%</td>
            <td style="color:${s.percent>=50?'var(--success)':'var(--danger)'}">${s.percent > 0 ? s.rank : '--'}</td>
            <td>ط§ظ„ظ€ ${index+1}</td>
            <td><button class="btn-view2" onclick="viewReport('${s.id}')"><i class="fa-solid fa-eye"></i> ط§ظ„طھظپط§طµظٹظ„</button></td>
        </tr>`;
    });
}

