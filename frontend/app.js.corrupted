// ==================== ط§ظ„طھط±ظپظٹط¹ ====================
function initPromotion() {
    const sf = document.getElementById('promoFrom'), st = document.getElementById('promoTo');
    const opts = '<option value="">-- ط§ط®طھط± ط§ظ„طµظپ --</option>' + DB.stages.map(s=>`<option>${s.grade}</option>`).join('') + '<option>ط®ط±ظٹط¬</option>';
    sf.innerHTML = opts; st.innerHTML = opts;
    
    sf.onchange = () => {
        const grade = sf.value, tb = document.getElementById('tbl-promotion');
        tb.innerHTML = '';
        if (!grade) return;
        DB.students.filter(s => s.grade_level===grade).forEach(s => {
            const sGrades = DB.grades.filter(g => g.sid === s.id);
            const totalScore = sGrades.reduce((sum, g) => sum + (g.total||0), 0);
            const percent = sGrades.length > 0 ? (totalScore / (sGrades.length*100) * 100) : 0;
            const isPass = percent >= 50;
            tb.innerHTML += `<tr>
                <td>${s.full_name}</td>
                <td style="font-weight:700">${percent.toFixed(1)}%</td>
                <td style="color:${isPass?'var(--success)':'var(--danger)'}"><i class="fa-solid ${isPass?'fa-check':'fa-xmark'}"></i> ${isPass?'ظ†ط§ط¬ط­':'ط±ط§ط³ط¨'}</td>
            </tr>`;
        });
    };
}
function promoteStudents() {
    const from = document.getElementById('promoFrom')?.value, to = document.getElementById('promoTo')?.value;
    const msg = document.getElementById('promoMsg');
    if (!from || !to || from===to) return toast('âڑ ï¸ڈ ظٹط±ط¬ظ‰ طھط­ط¯ظٹط¯ طµظپظˆظپ طµط­ظٹط­ط© ظ„ظ„طھط±ظپظٹط¹',1);
    
    let count = 0;
    DB.students.forEach(s => {
        if (s.grade_level === from) {
            const sGrades = DB.grades.filter(g => g.sid === s.id);
            const totalScore = sGrades.reduce((sum, g) => sum + (g.total||0), 0);
            const percent = sGrades.length > 0 ? (totalScore / (sGrades.length*100) * 100) : 0;
            if (percent >= 50) {
                s.grade_level = to; // Promote!
                count++;
            }
        }
    });
    
    msg.style.display = 'block';
    msg.innerHTML = `<i class="fa-solid fa-circle-check"></i> طھظ… طھط±ظپظٹط¹ <strong>${count}</strong> ط·ظ„ط§ط¨ ط¨ظ†ط¬ط§ط­ ظ…ظ† ${from} ط¥ظ„ظ‰ ${to}.`;
    addAudit('ط´ط¤ظˆظ† ط·ظ„ط§ط¨',`طھط±ظپظٹط¹ ${count} ط·ظ„ط§ط¨ ظ…ظ† ${from} ط¥ظ„ظ‰ ${to}`);
    toast('طھظ… طھط±ظپظٹط¹ ط§ظ„ط·ظ„ط§ط¨ ط¨ظ†ط¬ط§ط­ ًںژ‰');
    
    // طھط­ط¯ظٹط« ط§ظ„ط¬ط¯ظˆظ„
    document.getElementById('promoFrom').onchange();
    refreshAll();
}

