}

// --- طھط±ط­ظٹظ„ ---
function postVoucher(type, id) {
    const v = DB[type].find(v=>v.id===id);
    if(v){v.posted=true; addAudit('طھط±ط­ظٹظ„','طھط±ط­ظٹظ„ ط³ظ†ط¯ '+v.number); toast('طھظ… ط§ظ„طھط±ط­ظٹظ„ âœ…'); render(type);}
}
function postJournal(id) {
    const j = DB.journal.find(j=>j.id===id);
    if(j){j.posted=true; addAudit('طھط±ط­ظٹظ„','طھط±ط­ظٹظ„ ظ‚ظٹط¯ '+j.number); toast('طھظ… طھط±ط­ظٹظ„ ط§ظ„ظ‚ظٹط¯ âœ…'); render('journal');}
}

// --- ظ†ظ…ط§ط°ط¬ ط§ظ„ظ…ط­ط§ط³ط¨ط© ظپظٹ openForm ---
const origOpenForm = openForm;
openForm = function(type, editId = null) {
    if (['account','cashbox','vreceipt','vpayment','journalEntry'].includes(type)) {
        formType = type; formEditId = editId;
        const form = document.getElementById('dynamicForm'), title = document.getElementById('formTitle');
        const accOpts = DB.accounts.filter(a=>a.type==='طھط­ظ„ظٹظ„ظٹ').map(a=>`<option value="${a.name}">${a.code} - ${a.name}</option>`).join('');
        let h = '';
        if (type === 'account') {
            const d = editId ? DB.accounts.find(a=>a.id===editId) : {};
            const parentOpts = DB.accounts.filter(a=>a.type!=='طھط­ظ„ظٹظ„ظٹ').map(a=>`<option value="${a.id}" ${d.parent===a.id?'selected':''}>${a.code} - ${a.name}</option>`).join('');
            title.innerHTML = '<i class="fa-solid fa-sitemap"></i> ' + (editId?'طھط¹ط¯ظٹظ„':'ط¥ط¶ط§ظپط©') + ' ط­ط³ط§ط¨';
            h = `<div class="fg"><label>ط§ظ„ط­ط³ط§ط¨ ط§ظ„ط£ط¨</label><select id="f_parent"><option value="">(ط­ط³ط§ط¨ ط±ط¦ظٹط³ظٹ)</option>${parentOpts}</select></div>
            <div class="form-row"><div class="fg"><label>ط±ظ‚ظ… ط§ظ„ط­ط³ط§ط¨ <span class="req">*</span></label><input id="f_code" value="${d.code||''}"></div><div class="fg"><label>ط§ط³ظ… ط§ظ„ط­ط³ط§ط¨ <span class="req">*</span></label><input id="f_name" value="${d.name||''}"></div></div>
            <div class="form-row"><div class="fg"><label>ط§ظ„ظ†ظˆط¹</label><select id="f_type"><option ${d.type==='ط±ط¦ظٹط³ظٹ'?'selected':''}>ط±ط¦ظٹط³ظٹ</option><option ${d.type==='ظپط±ط¹ظٹ'?'selected':''}>ظپط±ط¹ظٹ</option><option ${d.type==='طھط­ظ„ظٹظ„ظٹ'?'selected':''}>طھط­ظ„ظٹظ„ظٹ</option></select></div><div class="fg"><label>ط§ظ„ط·ط¨ظٹط¹ط©</label><select id="f_nature"><option ${d.nature==='ظ…ط¯ظٹظ†'?'selected':''}>ظ…ط¯ظٹظ†</option><option ${d.nature==='ط¯ط§ط¦ظ†'?'selected':''}>ط¯ط§ط¦ظ†</option></select></div></div>
            ${d.type==='طھط­ظ„ظٹظ„ظٹ'||!editId?'<div class="fg"><label>ط§ظ„ط±طµظٹط¯ ط§ظ„ط§ظپطھطھط§ط­ظٹ</label><input type="number" id="f_balance" value="'+(d.balance||0)+'"></div>':''}`;
        } else if (type === 'cashbox') {
            const d = editId ? DB.cashboxes.find(c=>c.id===editId) : {};
            title.innerHTML = '<i class="fa-solid fa-vault"></i> ' + (editId?'طھط¹ط¯ظٹظ„':'ط¥ط¶ط§ظپط©') + ' طµظ†ط¯ظˆظ‚';
            h = `<div class="form-row"><div class="fg"><label>ط±ظ…ط² ط§ظ„طµظ†ط¯ظˆظ‚</label><input id="f_code" value="${d.code||'CB-'+String(nextId.cashboxes).padStart(3,'0')}"></div><div class="fg"><label>ط§ط³ظ… ط§ظ„طµظ†ط¯ظˆظ‚ <span class="req">*</span></label><input id="f_name" value="${d.name||''}"></div></div>
            <div class="form-row"><div class="fg"><label>ط§ظ„ظ†ظˆط¹</label><select id="f_type"><option ${d.type==='ظ‚ط¨ط¶ ظˆطµط±ظپ'?'selected':''}>ظ‚ط¨ط¶ ظˆطµط±ظپ</option><option ${d.type==='ظ‚ط¨ط¶ ظپظ‚ط·'?'selected':''}>ظ‚ط¨ط¶ ظپظ‚ط·</option><option ${d.type==='طµط±ظپ ظپظ‚ط·'?'selected':''}>طµط±ظپ ظپظ‚ط·</option></select></div><div class="fg"><label>ط§ظ„ظ…ط³ط¤ظˆظ„</label><input id="f_mgr" value="${d.manager||''}"></div></div>
            <div class="fg"><label>ط§ظ„ط±طµظٹط¯ ط§ظ„ط­ط§ظ„ظٹ</label><input type="number" id="f_balance" value="${d.balance||0}"></div>`;
        } else if (type === 'vreceipt') {
            title.innerHTML = '<i class="fa-solid fa-arrow-down"></i> ط³ظ†ط¯ ظ‚ط¨ط¶ ط¬ط¯ظٹط¯';
            h = `<div class="fg"><label>ظ…ظ† ط­ط³ط§ط¨ (ط§ظ„ظ…ط¯ظٹظ†)</label><select id="f_from">${accOpts}</select></div>
            <div class="fg"><label>ط¥ظ„ظ‰ ط­ط³ط§ط¨ (ط§ظ„ط¯ط§ط¦ظ†)</label><select id="f_to">${accOpts}</select></div>
            <div class="form-row"><div class="fg"><label>ط§ظ„ظ…ط¨ظ„ط؛ (ط±ظٹط§ظ„) <span class="req">*</span></label><input type="number" id="f_amount"></div><div class="fg"><label>ط·ط±ظٹظ‚ط© ط§ظ„ط¯ظپط¹</label><select id="f_method"><option>ظ†ظ‚ط¯ط§ظ‹</option><option>ط´ظٹظƒ</option><option>طھط­ظˆظٹظ„ ط¨ظ†ظƒظٹ</option></select></div></div>
            <div class="fg"><label>ط§ظ„ط¨ظٹط§ظ†</label><input id="f_desc" placeholder="ظˆطµظپ ط§ظ„ط¹ظ…ظ„ظٹط©"></div>`;
        } else if (type === 'vpayment') {
            title.innerHTML = '<i class="fa-solid fa-arrow-up"></i> ط³ظ†ط¯ طµط±ظپ ط¬ط¯ظٹط¯';
            h = `<div class="fg"><label>ظ…ظ† ط­ط³ط§ط¨ (ط§ظ„ط¯ط§ط¦ظ†)</label><select id="f_from">${accOpts}</select></div>
            <div class="fg"><label>ط¥ظ„ظ‰ ط­ط³ط§ط¨ (ط§ظ„ظ…ط¯ظٹظ†)</label><select id="f_to">${accOpts}</select></div>
            <div class="form-row"><div class="fg"><label>ط§ظ„ظ…ط¨ظ„ط؛ (ط±ظٹط§ظ„) <span class="req">*</span></label><input type="number" id="f_amount"></div><div class="fg"><label>ط·ط±ظٹظ‚ط© ط§ظ„ط¯ظپط¹</label><select id="f_method"><option>ظ†ظ‚ط¯ط§ظ‹</option><option>ط´ظٹظƒ</option><option>طھط­ظˆظٹظ„ ط¨ظ†ظƒظٹ</option></select></div></div>
            <div class="fg"><label>ط§ظ„ط¨ظٹط§ظ†</label><input id="f_desc" placeholder="ظˆطµظپ ط§ظ„ط¹ظ…ظ„ظٹط©"></div>`;
        } else if (type === 'journalEntry') {
            const d = editId ? DB.journal.find(j=>j.id===editId) : {};
            title.innerHTML = '<i class="fa-solid fa-book-open"></i> ' + (editId?'طھط¹ط¯ظٹظ„':'ط¥ظ†ط´ط§ط،') + ' ظ‚ظٹط¯ ظٹظˆظ…ظٹ';
            h = `<div class="fg"><label>ط§ظ„ط¨ظٹط§ظ† <span class="req">*</span></label><input id="f_desc" value="${d.desc||''}" placeholder="ظˆطµظپ ط§ظ„ظ‚ظٹط¯ ط§ظ„ظ…ط­ط§ط³ط¨ظٹ"></div>
            <div class="fg"><label>ط§ظ„ط­ط³ط§ط¨ ط§ظ„ظ…ط¯ظٹظ†</label><select id="f_debitAcc">${DB.accounts.filter(a=>a.type==='طھط­ظ„ظٹظ„ظٹ').map(a=>`<option value="${a.name}" ${d.debitAcc===a.name?'selected':''}>${a.code} - ${a.name}</option>`).join('')}</select></div>
            <div class="fg"><label>ط§ظ„ط­ط³ط§ط¨ ط§ظ„ط¯ط§ط¦ظ†</label><select id="f_creditAcc">${DB.accounts.filter(a=>a.type==='طھط­ظ„ظٹظ„ظٹ').map(a=>`<option value="${a.name}" ${d.creditAcc===a.name?'selected':''}>${a.code} - ${a.name}</option>`).join('')}</select></div>
            <div class="form-row"><div class="fg"><label>ط§ظ„ظ…ط¨ظ„ط؛ ط§ظ„ظ…ط¯ظٹظ† <span class="req">*</span></label><input type="number" id="f_debit" value="${d.debit||''}"></div><div class="fg"><label>ط§ظ„ظ…ط¨ظ„ط؛ ط§ظ„ط¯ط§ط¦ظ† <span class="req">*</span></label><input type="number" id="f_credit" value="${d.credit||''}"></div></div>`;
        }
        form.innerHTML = h;
        document.getElementById('formModal').classList.add('active');
    } else {
        origOpenForm(type, editId);
    }
};

// --- ط­ظپط¸ ظ†ظ…ط§ط°ط¬ ط§ظ„ظ…ط­ط§ط³ط¨ط© ---
const origSaveForm = saveForm;
saveForm = function() {
    if (formType === 'account') {
        const code = gv('f_code'), name = gv('f_name');
        if (!code || !name) return toast('âڑ ï¸ڈ ط±ظ‚ظ… ظˆط§ط³ظ… ط§ظ„ط­ط³ط§ط¨ ظ…ط·ظ„ظˆط¨ط§ظ†',1);
        const o = {id: code, code, name, parent: gv('f_parent')||null, type: gv('f_type'), nature: gv('f_nature'), level: gv('f_parent') ? (DB.accounts.find(a=>a.id===gv('f_parent'))?.level||0)+1 : 1};
        const balEl = document.getElementById('f_balance'); if (balEl) o.balance = parseInt(balEl.value)||0;
        if (formEditId) { const i = DB.accounts.findIndex(a=>a.id===formEditId); if(i>=0) Object.assign(DB.accounts[i],o); addAudit('طھط¹ط¯ظٹظ„','طھط¹ط¯ظٹظ„ ط­ط³ط§ط¨: '+name); }
        else { DB.accounts.push(o); addAudit('ط¥ط¶ط§ظپط©','ط¥ط¶ط§ظپط© ط­ط³ط§ط¨: '+code+' '+name); }
        buildAccountsTree();
    } else if (formType === 'cashbox') {
        const o = {code:gv('f_code'),name:gv('f_name'),type:gv('f_type'),balance:parseInt(gv('f_balance'))||0,manager:gv('f_mgr')};
        if (!o.name) return toast('âڑ ï¸ڈ ط§ط³ظ… ط§ظ„طµظ†ط¯ظˆظ‚ ظ…ط·ظ„ظˆط¨',1);
        if (formEditId) { const i=DB.cashboxes.findIndex(c=>c.id===formEditId);if(i>=0)Object.assign(DB.cashboxes[i],o);addAudit('طھط¹ط¯ظٹظ„','طھط¹ط¯ظٹظ„ طµظ†ط¯ظˆظ‚: '+o.name); }
        else { o.id=nextId.cashboxes++;DB.cashboxes.push(o);addAudit('ط¥ط¶ط§ظپط©','ط¥ط¶ط§ظپط© طµظ†ط¯ظˆظ‚: '+o.name); }
        render('cashboxes');
    } else if (formType === 'vreceipt') {
        const amt = parseInt(gv('f_amount'));
        if (!amt||amt<=0) return toast('âڑ ï¸ڈ ط£ط¯ط®ظ„ ظ…ط¨ظ„ط؛ طµط­ظٹط­',1);
        const o = {id:nextId.vreceipts++,number:`VR-${String(nextId.vreceipts).padStart(3,'0')}`,date:new Date().toLocaleDateString('en-CA'),fromAcc:gv('f_from'),toAcc:gv('f_to'),amount:amt,desc:gv('f_desc'),method:gv('f_method'),posted:false};
        DB.vreceipts.push(o);
        // ط£ظ†ط´ط¦ ظ‚ظٹط¯ ظٹظˆظ…ظٹ طھظ„ظ‚ط§ط¦ظٹ
        DB.journal.push({id:nextId.journal++,number:`JE-${String(nextId.journal).padStart(3,'0')}`,date:o.date,desc:'ط³ظ†ط¯ ظ‚ط¨ط¶: '+o.desc,debitAcc:o.toAcc,creditAcc:o.fromAcc,debit:amt,credit:amt,posted:false});
        addAudit('ط³ظ†ط¯ ظ‚ط¨ط¶',`${o.number} - ${amt.toLocaleString()} ط±ظٹط§ظ„`);
        render('vreceipts');
    } else if (formType === 'vpayment') {
        const amt = parseInt(gv('f_amount'));
        if (!amt||amt<=0) return toast('âڑ ï¸ڈ ط£ط¯ط®ظ„ ظ…ط¨ظ„ط؛ طµط­ظٹط­',1);
        const o = {id:nextId.vpayments++,number:`VP-${String(nextId.vpayments).padStart(3,'0')}`,date:new Date().toLocaleDateString('en-CA'),fromAcc:gv('f_from'),toAcc:gv('f_to'),amount:amt,desc:gv('f_desc'),method:gv('f_method'),posted:false};
        DB.vpayments.push(o);
        DB.journal.push({id:nextId.journal++,number:`JE-${String(nextId.journal).padStart(3,'0')}`,date:o.date,desc:'ط³ظ†ط¯ طµط±ظپ: '+o.desc,debitAcc:o.toAcc,creditAcc:o.fromAcc,debit:amt,credit:amt,posted:false});
        addAudit('ط³ظ†ط¯ طµط±ظپ',`${o.number} - ${amt.toLocaleString()} ط±ظٹط§ظ„`);
        render('vpayments');
    } else if (formType === 'journalEntry') {
        const desc=gv('f_desc'),debit=parseInt(gv('f_debit')),credit=parseInt(gv('f_credit'));
        if (!desc) return toast('âڑ ï¸ڈ ط§ظ„ط¨ظٹط§ظ† ظ…ط·ظ„ظˆط¨',1);
        if (!debit||!credit) return toast('âڑ ï¸ڈ ط§ظ„ظ…ط¨ظ„ط؛ ظ…ط·ظ„ظˆط¨',1);
        if (debit!==credit) return toast('âڑ ï¸ڈ ط§ظ„ظ…ط¨ظ„ط؛ ط§ظ„ظ…ط¯ظٹظ† ظٹط¬ط¨ ط£ظ† ظٹط³ط§ظˆظٹ ط§ظ„ط¯ط§ط¦ظ†',1);
        const o = {desc,debitAcc:gv('f_debitAcc'),creditAcc:gv('f_creditAcc'),debit,credit,posted:false};
        if (formEditId) { const i=DB.journal.findIndex(j=>j.id===formEditId);if(i>=0)Object.assign(DB.journal[i],o);addAudit('طھط¹ط¯ظٹظ„','طھط¹ط¯ظٹظ„ ظ‚ظٹط¯'); }
        else { o.id=nextId.journal++;o.number=`JE-${String(nextId.journal).padStart(3,'0')}`;o.date=new Date().toLocaleDateString('en-CA');DB.journal.push(o);addAudit('ظ‚ظٹط¯ ظٹظˆظ…ظٹ','ط¥ظ†ط´ط§ط، ظ‚ظٹط¯: '+desc); }
        render('journal');
    } else if (formType === 'schedule') {
        const o = {id:nextId.schedule++, section:gv('f_sec'), day:gv('f_day'), p1:gv('f_p1'), p2:gv('f_p2'), p3:gv('f_p3'), p4:gv('f_p4'), p5:gv('f_p5'), p6:gv('f_p6')};
        DB.schedule.push(o); addAudit('ط¬ط¯ظˆظ„','ط¥ط¶ط§ظپط© ط¬ط¯ظˆظ„ ظٹظˆظ… '+o.day+' ظ„ط´ط¹ط¨ط© '+o.section);
        const secSel = document.getElementById('schSection'); if(secSel) { secSel.value = o.section; renderSchedule(); }
    } else if (formType === 'substitute') {
        const o = {id:nextId.substitutes++, date:gv('f_date'), day:gv('f_day'), period:gv('f_period'), section:gv('f_sec'), absent:gv('f_absent'), substitute:gv('f_sub')};
        DB.substitutes.push(o); addAudit('ط§ط­طھظٹط§ط·',`ط¥ط³ظ†ط§ط¯ ط§ط­طھظٹط§ط· ظ„ظ€ ${o.substitute} ط¨ط¯ظ„ط§ظ‹ ط¹ظ† ${o.absent}`);
        render('substitute');
    } else if (formType === 'activity') {
        const o = {name:gv('f_name'), type:gv('f_type'), date:gv('f_date'), supervisor:gv('f_sup'), participants:parseInt(gv('f_participants'))||0};
        if(!o.name) return toast('âڑ ï¸ڈ ط§ط³ظ… ط§ظ„ظ†ط´ط§ط· ظ…ط·ظ„ظˆط¨',1);
        if(formEditId) { const i=DB.activities.findIndex(a=>a.id===formEditId); if(i>=0) Object.assign(DB.activities[i],o); addAudit('طھط¹ط¯ظٹظ„',`طھط¹ط¯ظٹظ„ ظ†ط´ط§ط· ${o.name}`); }
        else { o.id = nextId.activities++; DB.activities.push(o); addAudit('ط£ظ†ط´ط·ط©',`ط¥ط¶ط§ظپط© ظ†ط´ط§ط· ${o.name}`); }
        render('activities');
    } else if (formType === 'transport') {
        const o = {route:gv('f_route'), driver:gv('f_driver'), bus:gv('f_bus'), fee:parseInt(gv('f_fee'))||0};
        if(!o.route) return toast('âڑ ï¸ڈ ط§ط³ظ… ط§ظ„ط®ط· ظ…ط·ظ„ظˆط¨',1);
        if(formEditId) { const i=DB.transport.findIndex(t=>t.id===formEditId); if(i>=0) Object.assign(DB.transport[i],o); addAudit('طھط¹ط¯ظٹظ„',`طھط¹ط¯ظٹظ„ ط®ط· ط³ظٹط± ${o.route}`); }
        else { o.id = nextId.transport++; DB.transport.push(o); addAudit('ظ…ظˆط§طµظ„ط§طھ',`ط¥ط¶ط§ظپط© ط®ط· ط³ظٹط± ${o.route}`); }
        render('transport');
    } else {
        origSaveForm(); return;
    }
    closeModal('formModal');
    toast(formEditId ? 'طھظ… ط§ظ„طھط¹ط¯ظٹظ„ âœ…' : 'طھظ…طھ ط§ظ„ط¥ط¶ط§ظپط© âœ…');
};

// --- ط­ط°ظپ ط§ظ„ظ…ط­ط§ط³ط¨ط© ---
const origConfirmDel = confirmDel;
confirmDel = function() {
    if (delType === 'account') { DB.accounts = DB.accounts.filter(a=>a.id!==delId); buildAccountsTree(); addAudit('ط­ط°ظپ','ط­ط°ظپ ط­ط³ط§ط¨'); closeModal('deleteModal'); toast('طھظ… ط§ظ„ط­ط°ظپ ًں—‘ï¸ڈ'); return; }
    if (delType === 'cashbox') { DB.cashboxes = DB.cashboxes.filter(c=>c.id!==delId); render('cashboxes'); addAudit('ط­ط°ظپ','ط­ط°ظپ طµظ†ط¯ظˆظ‚'); closeModal('deleteModal'); toast('طھظ… ط§ظ„ط­ط°ظپ ًں—‘ï¸ڈ'); return; }
    origConfirmDel();
};

// --- ظƒط´ظپ ط§ظ„ط­ط³ط§ط¨ ---
function initAccStatement() {
    const sel = document.getElementById('stmtAccount');
    sel.innerHTML = '<option value="">-- ط§ط®طھط± ط§ظ„ط­ط³ط§ط¨ --</option>' + DB.accounts.filter(a=>a.type==='طھط­ظ„ظٹظ„ظٹ').map(a=>`<option value="${a.name}">${a.code} - ${a.name}</option>`).join('');
}
function renderAccStatement() {
    const accName = document.getElementById('stmtAccount').value, div = document.getElementById('accStatementView');
    if (!accName) { div.innerHTML=''; return; }
    const acc = DB.accounts.find(a=>a.name===accName);
    let html = `<div class="s-info"><div><span class="lbl">ط§ظ„ط­ط³ط§ط¨</span>${acc?.code} - ${accName}</div><div><span class="lbl">ط§ظ„ط·ط¨ظٹط¹ط©</span>${acc?.nature}</div><div><span class="lbl">ط§ظ„ط±طµظٹط¯</span>${(acc?.balance||0).toLocaleString()} ط±ظٹط§ظ„</div></div>`;
    // ط¬ظ„ط¨ ظƒظ„ ط§ظ„ط­ط±ظƒط§طھ ط§ظ„ظ…طھط¹ظ„ظ‚ط© ط¨ظ‡ط°ط§ ط§ظ„ط­ط³ط§ط¨
    const movements = [];
    DB.journal.filter(j=>j.posted).forEach(j => {
        if (j.debitAcc===accName) movements.push({date:j.date,desc:j.desc,debit:j.debit,credit:0,ref:j.number});
        if (j.creditAcc===accName) movements.push({date:j.date,desc:j.desc,debit:0,credit:j.credit,ref:j.number});
    });
    if (movements.length) {
        html += '<div class="table-wrapper"><table><thead><tr><th>ط§ظ„طھط§ط±ظٹط®</th><th>ط§ظ„ط¨ظٹط§ظ†</th><th>ط§ظ„ظ…ط±ط¬ط¹</th><th>ظ…ط¯ظٹظ†</th><th>ط¯ط§ط¦ظ†</th><th>ط§ظ„ط±طµظٹط¯</th></tr></thead><tbody>';
        let running = acc?.balance || 0;
        movements.forEach(m => {
            running += m.debit - m.credit;
            html += `<tr><td>${m.date}</td><td>${m.desc}</td><td>${m.ref}</td><td style="color:var(--success)">${m.debit?m.debit.toLocaleString():'-'}</td><td style="color:var(--danger)">${m.credit?m.credit.toLocaleString():'-'}</td><td style="font-weight:700">${running.toLocaleString()}</td></tr>`;
        });
        html += '</tbody></table></div>';
    } else html += '<p style="color:var(--muted);text-align:center;padding:20px">ظ„ط§ طھظˆط¬ط¯ ط­ط±ظƒط§طھ ظ…ط±ط­ظ‘ظ„ط© ط¹ظ„ظ‰ ظ‡ط°ط§ ط§ظ„ط­ط³ط§ط¨</p>';
    div.innerHTML = html;
}

// --- ظ…ظٹط²ط§ظ† ط§ظ„ظ…ط±ط§ط¬ط¹ط© ---
function renderTrialBalance() {
    const tb = document.getElementById('tbl-trial-balance');
    let totalD=0, totalC=0;
    tb.innerHTML = '';
    DB.accounts.filter(a=>a.type==='طھط­ظ„ظٹظ„ظٹ').forEach(a => {
        let d=0, c=0;
        DB.journal.filter(j=>j.posted).forEach(j => {
            if (j.debitAcc===a.name) d += j.debit;
            if (j.creditAcc===a.name) c += j.credit;
        });
        // ط£ط¶ظپ ط§ظ„ط±طµظٹط¯ ط§ظ„ط§ظپطھطھط§ط­ظٹ
        if (a.nature==='ظ…ط¯ظٹظ†') d += (a.balance||0); else c += (a.balance||0);
        const bal = d - c;
        totalD += d; totalC += c;
        tb.innerHTML += `<tr><td>${a.code}</td><td>${a.name}</td><td style="color:var(--success)">${d.toLocaleString()}</td><td style="color:var(--danger)">${c.toLocaleString()}</td><td style="font-weight:700;color:${bal>=0?'var(--success)':'var(--danger)'}">${bal.toLocaleString()}</td></tr>`;
    });
    document.getElementById('tbTotalDebit').textContent = totalD.toLocaleString();
    document.getElementById('tbTotalCredit').textContent = totalC.toLocaleString();
}

// --- ظ‚ط§ط¦ظ…ط© ط§ظ„ط¯ط®ظ„ ---
function renderIncomeStmt() {
    const div = document.getElementById('incomeStmtView');
    // ط­ط³ط§ط¨ ط§ظ„ط¥ظٹط±ط§ط¯ط§طھ
    let totalRev = 0, totalExp = 0;
    const revAccs = DB.accounts.filter(a=>a.parent && (a.parent.startsWith('4')||DB.accounts.find(p=>p.id===a.parent)?.parent?.startsWith('4')) && a.type==='طھط­ظ„ظٹظ„ظٹ');
    const expAccs = DB.accounts.filter(a=>a.parent && (a.parent.startsWith('3')||DB.accounts.find(p=>p.id===a.parent)?.parent?.startsWith('3')) && a.type==='طھط­ظ„ظٹظ„ظٹ');
    
    let html = '<h3 style="margin-bottom:12px;color:var(--success)"><i class="fa-solid fa-arrow-trend-up"></i> ط§ظ„ط¥ظٹط±ط§ط¯ط§طھ</h3><div class="table-wrapper"><table><thead><tr><th>ط§ظ„ط­ط³ط§ط¨</th><th>ط§ظ„ظ…ط¨ظ„ط؛ (ط±ظٹط§ظ„)</th></tr></thead><tbody>';
    revAccs.forEach(a => { totalRev += (a.balance||0); html += `<tr><td>${a.code} - ${a.name}</td><td style="color:var(--success);font-weight:700">${(a.balance||0).toLocaleString()}</td></tr>`; });
    html += `<tr style="background:rgba(16,185,129,.08)"><td style="font-weight:800">ط¥ط¬ظ…ط§ظ„ظٹ ط§ظ„ط¥ظٹط±ط§ط¯ط§طھ</td><td style="font-weight:800;color:var(--success)">${totalRev.toLocaleString()}</td></tr></tbody></table></div>`;
    
    html += '<h3 style="margin:20px 0 12px;color:var(--danger)"><i class="fa-solid fa-arrow-trend-down"></i> ط§ظ„ظ…طµط±ظˆظپط§طھ</h3><div class="table-wrapper"><table><thead><tr><th>ط§ظ„ط­ط³ط§ط¨</th><th>ط§ظ„ظ…ط¨ظ„ط؛ (ط±ظٹط§ظ„)</th></tr></thead><tbody>';
    expAccs.forEach(a => { totalExp += (a.balance||0); html += `<tr><td>${a.code} - ${a.name}</td><td style="color:var(--danger);font-weight:700">${(a.balance||0).toLocaleString()}</td></tr>`; });
    html += `<tr style="background:rgba(239,68,68,.08)"><td style="font-weight:800">ط¥ط¬ظ…ط§ظ„ظٹ ط§ظ„ظ…طµط±ظˆظپط§طھ</td><td style="font-weight:800;color:var(--danger)">${totalExp.toLocaleString()}</td></tr></tbody></table></div>`;
    
    const net = totalRev - totalExp;
    html += `<div class="stats-row" style="margin-top:18px"><div class="stat-card ${net>=0?'c-green':'c-red'}"><i class="fa-solid ${net>=0?'fa-arrow-trend-up':'fa-arrow-trend-down'}"></i><div><span class="stat-number">${net.toLocaleString()}</span><span class="stat-label">${net>=0?'طµط§ظپظٹ ط§ظ„ط±ط¨ط­':'طµط§ظپظٹ ط§ظ„ط®ط³ط§ط±ط©'} (ط±ظٹط§ظ„)</span></div></div></div>`;
    div.innerHTML = html;
}

// ==================== وظائف الطباعة ====================
function printDiv(title, htmlContent) {
    const w = window.open('', '_blank');
    w.document.write(
        <html dir="rtl">
        <head>
            <title>${title}</title>
            <style>
                @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap');
                body { font-family: 'Tajawal', sans-serif; padding: 20px; color: #333; }
                .print-header { text-align: center; margin-bottom: 20px; border-bottom: 2px solid #ddd; padding-bottom: 10px; }
                table { width: 100%; border-collapse: collapse; margin-top: 15px; }
                th, td { border: 1px solid #ddd; padding: 8px; text-align: center; }
                th { background: #f5f5f5; }
                .stats-row { display: flex; justify-content: space-around; margin: 15px 0; }
                .stat-card { border: 1px solid #ddd; padding: 15px; border-radius: 8px; text-align: center; flex: 1; margin: 0 10px; }
                .s-info { display: flex; justify-content: space-between; border: 1px solid #ddd; padding: 15px; border-radius: 8px; margin-bottom: 15px; }
                .s-info div { display: flex; flex-direction: column; }
                .lbl { font-weight: bold; color: #666; font-size: 0.85em; margin-bottom: 5px; }
                h4 { margin-top: 20px; }
                @media print {
                    button, .no-print { display: none !important; }
                }
            </style>
        </head>
        <body>
            <div class="print-header">
                <h2>${DB.schools[0]?.name || 'نظام الإدارة المدرسية'}</h2>
                <h3>${title}</h3>
                <p>تاريخ الطباعة: ${new Date().toLocaleDateString('en-CA')}</p>
            </div>
            ${htmlContent}
            <script>setTimeout(()=>{window.print(); window.close();}, 500);</script>
        </body>
        </html>
    );
    w.document.close();
}

function printReceipt(id) {
    const r = DB.receipts.find(x => x.id == id);
    if (!r) return;
    const html = 
        <div style="border:2px dashed #ccc; padding:20px; border-radius:10px; max-width:500px; margin:auto; text-align:center;">
            <h3 style="border-bottom:1px solid #eee; padding-bottom:10px;">سند قبض مالي رقم: ${r.number}</h3>
            <p style="text-align:right;"><strong>التاريخ:</strong> ${r.date}</p>
            <p style="text-align:right;"><strong>استلمنا من الطالب/ة:</strong> ${r.studentName}</p>
            <p style="text-align:right;"><strong>مبلغ وقدره:</strong> ${r.amount.toLocaleString()} ريال</p>
            <p style="text-align:right;"><strong>طريقة الدفع:</strong> ${r.method}</p>
            ${r.notes ? <p style="text-align:right;"><strong>ملاحظات:</strong> ${r.notes}</p> : ''}
            <br><br><br>
            <div style="display:flex; justify-content:space-between; margin-top:30px;">
                <span>توقيع المحاسب: ....................</span>
                <span>توقيع المستلم: ....................</span>
            </div>
        </div>
    ;
    printDiv('سند قبض مالي', html);
}

function printStudentAccount() {
    const sid = document.getElementById('accStudent').value;
    if (!sid) return toast('يرجى اختيار طالب أولاً', 1);
    const html = document.getElementById('studentAccountView').innerHTML;
    printDiv('كشف حساب طالب', html);
}

function printFinanceReport() {
    const html = 
        <div class="stats-row">
            <div class="stat-card"><h3>إجمالي التحصيل</h3><p>${document.getElementById('frRevenue').textContent} ريال</p></div>
            <div class="stat-card"><h3>إجمالي المتأخرات</h3><p>${document.getElementById('frDebt').textContent} ريال</p></div>
        </div>
        <table>
            <thead><tr><th>الطالب</th><th>المرحلة</th><th>الرسوم</th><th>المسدد</th><th>المتبقي</th><th>الحالة</th></tr></thead>
            <tbody>${document.getElementById('tbl-finance-report').innerHTML}</tbody>
        </table>
    ;
    printDiv('التقرير المالي الإجمالي', html);
}
