function addAudit(action, detail) {
    DB.audit.unshift({date: new Date().toLocaleString('ar-EG'), user: me?.username||'system', action, detail});
    render('audit');
}

// ==================== ط§ظ„ظ†ظ…ط§ط°ط¬ (Forms) ====================
let formType = null, formEditId = null;
const stageNames = ["ط§ظ„ظ…ط±ط­ظ„ط© ط§ظ„ط§ط¨طھط¯ط§ط¦ظٹط©","ط§ظ„ظ…ط±ط­ظ„ط© ط§ظ„ط¥ط¹ط¯ط§ط¯ظٹط©","ط§ظ„ظ…ط±ط­ظ„ط© ط§ظ„ط«ط§ظ†ظˆظٹط©"];
function updateStageGrades(stage, selectedGrade = '') {
    const gradesMap = {
        "ط§ظ„ظ…ط±ط­ظ„ط© ط§ظ„ط§ط¨طھط¯ط§ط¦ظٹط©": ["ط§ظ„طµظپ ط§ظ„ط£ظˆظ„", "ط§ظ„طµظپ ط§ظ„ط«ط§ظ†ظٹ", "ط§ظ„طµظپ ط§ظ„ط«ط§ظ„ط«", "ط§ظ„طµظپ ط§ظ„ط±ط§ط¨ط¹", "ط§ظ„طµظپ ط§ظ„ط®ط§ظ…ط³", "ط§ظ„طµظپ ط§ظ„ط³ط§ط¯ط³"],
        "ط§ظ„ظ…ط±ط­ظ„ط© ط§ظ„ط¥ط¹ط¯ط§ط¯ظٹط©": ["ط§ظ„طµظپ ط§ظ„ط³ط§ط¨ط¹", "ط§ظ„طµظپ ط§ظ„ط«ط§ظ…ظ†", "ط§ظ„طµظپ ط§ظ„طھط§ط³ط¹"],
        "ط§ظ„ظ…ط±ط­ظ„ط© ط§ظ„ط«ط§ظ†ظˆظٹط©": ["ط§ظ„طµظپ ط§ظ„ط£ظˆظ„ ط«ط§ظ†ظˆظٹ", "ط§ظ„طµظپ ط§ظ„ط«ط§ظ†ظٹ ط«ط§ظ†ظˆظٹ", "ط§ظ„طµظپ ط§ظ„ط«ط§ظ„ط« ط«ط§ظ†ظˆظٹ"]
    };
    const sel = document.getElementById('f_grade');
    if (sel && gradesMap[stage]) {
        sel.innerHTML = gradesMap[stage].map(g => `<option value="${g}" ${g === selectedGrade ? 'selected' : ''}>${g}</option>`).join('');
    }
}

function openForm(type, editId = null) {
    formType = type; formEditId = editId;
    const form = document.getElementById('dynamicForm'), title = document.getElementById('formTitle');
    let h = '';
    if (type === 'school') {
        const d = editId ? DB.schools.find(s=>s.id===editId) : {};
        title.innerHTML = `<i class="fa-solid fa-school"></i> ${editId?'طھط¹ط¯ظٹظ„':'ط¥ط¶ط§ظپط©'} ظ…ط¯ط±ط³ط© (طھط±ط®ظٹطµ ظˆطھط£ط³ظٹط³)`;
        h = `<div class="form-row"><div class="fg full"><label>ط§ط³ظ… ط§ظ„ظ…ط¯ط±ط³ط© ط§ظ„ط±ط³ظ…ظٹ (ط§ظ„طھط¬ط§ط±ظٹ) <span class="req">*</span></label><input id="f_name" value="${d.name||''}" placeholder="ظٹط¬ط¨ ط£ظ† ظٹط­ظ…ظ„ ط¯ظ„ط§ظ„ط© طھط¹ظ„ظٹظ…ظٹط© ظ…ط«ظ„: ظ…ط¯ط§ط±ط³ ... ط§ظ„ط£ظ‡ظ„ظٹط©"></div></div>
        <div class="form-row"><div class="fg"><label>ط§ظ„ظ…ط­ط§ظپط¸ط© / ط§ظ„ظ…ط¯ظٹط±ظٹط©</label><input id="f_gov" value="${d.gov||''}" placeholder="طµظ†ط¹ط§ط، - ط§ظ„ط³ط¨ط¹ظٹظ†"></div><div class="fg"><label>ظ…ظƒط§ظ† ط§ظ„ظ…ط¯ط±ط³ط© (ط§ظ„ط¹ظ†ظˆط§ظ†)</label><input id="f_loc" value="${d.loc||''}"></div></div>
        <div class="form-row"><div class="fg"><label>ط§ظ„ظ…ط±ظƒط²</label><select id="f_center"><option ${d.center==='ط¨ظ†ظٹظ†'?'selected':''}>ط¨ظ†ظٹظ†</option><option ${d.center==='ط¨ظ†ط§طھ'?'selected':''}>ط¨ظ†ط§طھ</option><option ${d.center==='ظ…ط®طھظ„ط·'?'selected':''}>ظ…ط®طھظ„ط·</option></select></div><div class="fg"><label>ط´ط¹ط§ط± ط§ظ„ظ…ط¯ط±ط³ط©</label><input type="file" id="f_logo" accept="image/*"></div></div>
        
        <fieldset style="border:1px solid var(--border); border-radius:8px; padding:10px; margin-bottom:14px;"><legend style="color:var(--muted); font-size:0.85rem; padding:0 5px;">ظˆط²ط§ط±ط© ط§ظ„طµظ†ط§ط¹ط© ظˆط§ظ„طھط¬ط§ط±ط© (ط§ظ„ظ…طھط·ظ„ط¨ط§طھ ط§ظ„ط§ط³طھط«ظ…ط§ط±ظٹط©)</legend>
        <div class="form-row"><div class="fg"><label>ظ†ظˆط¹ ط§ظ„ظƒظٹط§ظ†</label><select id="f_entity"><option ${d.entity==='ط´ط±ظƒط© ط°ط§طھ ظ…ط³ط¤ظˆظ„ظٹط© ظ…ط­ط¯ظˆط¯ط©'?'selected':''}>ط´ط±ظƒط© ط°ط§طھ ظ…ط³ط¤ظˆظ„ظٹط© ظ…ط­ط¯ظˆط¯ط©</option><option ${d.entity==='ظ…ظ†ط´ط£ط© ظپط±ط¯ظٹط©'?'selected':''}>ظ…ظ†ط´ط£ط© ظپط±ط¯ظٹط©</option></select></div><div class="fg"><label>ط±ط£ط³ ط§ظ„ظ…ط§ظ„ ط§ظ„طھط£ط³ظٹط³ظٹ</label><input type="number" id="f_capital" value="${d.capital||''}"></div></div>
        <div class="form-row"><div class="fg"><label>ط±ظ‚ظ… ط§ظ„ط³ط¬ظ„ ط§ظ„طھط¬ط§ط±ظٹ</label><input id="f_cr_num" value="${d.cr_num||''}"></div><div class="fg"><label>ط´ظ‡ط§ط¯ط© ط¨ظ†ظƒظٹط© / ط¶ظ…ط§ظ†ط©</label><input type="file" id="f_bank_cert" accept="image/*,.pdf"></div></div>
        </fieldset>

        <fieldset style="border:1px solid var(--border); border-radius:8px; padding:10px; margin-bottom:14px;"><legend style="color:var(--muted); font-size:0.85rem; padding:0 5px;">ظˆط²ط§ط±ط© ط§ظ„طھط±ط¨ظٹط© ظˆط§ظ„طھط¹ظ„ظٹظ… (ط§ظ„طھط±ط®ظٹطµ ظˆط§ظ„ظ…ط¨ظ†ظ‰)</legend>
