// ==================== SAAS Super Admin ====================
function renderSchools() {
    const tb = document.getElementById('tbl-schools');
    if (!tb) return;
    tb.innerHTML = '';
    DB.schools.forEach(s => {
        const stat = s.status === 'ظ†ط´ط·' ? '<span style="color:var(--success)"><i class="fa-solid fa-circle-check"></i> ظ†ط´ط·</span>' : '<span style="color:var(--danger)"><i class="fa-solid fa-circle-xmark"></i> ظ…ظˆظ‚ظˆظپ</span>';
        tb.innerHTML += `<tr><td>${s.id}</td><td style="font-weight:700"><i class="fa-solid fa-school text-indigo-500"></i> ${s.name}</td><td>${stat}</td><td>${s.subscriptionEnd}</td><td><span class="badge">${s.usersCount}</span></td><td><div class="act"><button class="btn-edit" onclick="alert('طھط¹ط¯ظٹظ„ ط§ط´طھط±ط§ظƒ ط§ظ„ظ…ط¯ط±ط³ط© (${s.name})')"><i class="fa-solid fa-pen"></i></button><button class="btn-danger" onclick="alert('ط¥ظٹظ‚ط§ظپ ط§ظ„ظ…ط¯ط±ط³ط© (${s.name})')" style="background:var(--danger);color:white"><i class="fa-solid fa-power-off"></i></button></div></td></tr>`;
    });
}
function addSchoolPrompt() {
    const n = prompt("ط£ط¯ط®ظ„ ط§ط³ظ… ط§ظ„ظ…ط¯ط±ط³ط© ط§ظ„ط¬ط¯ظٹط¯ط©:");
    if (!n) return;
    DB.schools.push({id: nextId.schools++, name: n, status: 'ظ†ط´ط·', subscriptionEnd: '2027-01-01', usersCount: 0});
    renderSchools();
    toast('طھظ…طھ ط¥ط¶ط§ظپط© ط§ظ„ظ…ط¯ط±ط³ط© ط¨ظ†ط¬ط§ط­!');
}

// ==================== ط£ط¯ظˆط§طھ ظ…ط³ط§ط¹ط¯ط© ====================
function gv(id) { const el = document.getElementById(id); return el ? el.value.trim() : ''; }
function closeModal(id) { document.getElementById(id).classList.remove('active'); }
function toast(msg, isErr=false) { const t=document.getElementById('toastMsg'); document.getElementById('toastText').textContent=msg; t.style.background=isErr?'linear-gradient(135deg,#ef4444,#dc2626)':'linear-gradient(135deg,#10b981,#059669)'; t.classList.add('visible'); setTimeout(()=>t.classList.remove('visible'),2500); }
function saveSchoolInfo() { addAudit('طھط¹ط¯ظٹظ„','طھط¹ط¯ظٹظ„ ظ…ط¹ظ„ظˆظ…ط§طھ ط§ظ„ظ…ط¯ط±ط³ط©'); toast('طھظ… ط­ظپط¸ ظ…ط¹ظ„ظˆظ…ط§طھ ط§ظ„ظ…ط¯ط±ط³ط© âœ…'); }

// ط§ظ„طھط­ظ‚ظ‚ ظ…ظ† ط§ظ„ظ…ط¯ط®ظ„ط§طھ
function applyLetters(id){const el=document.getElementById(id);if(!el)return;el.addEventListener('input',()=>{el.value=el.value.replace(/[^a-zA-Z\u0600-\u06FF\s]/g,'');})}
function applyPhone(id){const el=document.getElementById(id);if(!el)return;el.setAttribute('maxlength','9');el.addEventListener('input',()=>{let v=el.value.replace(/[^0-9]/g,'');if(v.length>0&&v[0]!=='7')v='7'+v.substring(1);el.value=v.substring(0,9);})}
function applyNumbers(id){const el=document.getElementById(id);if(!el)return;el.addEventListener('input',()=>{el.value=el.value.replace(/[^0-9]/g,'');})}

// ==================== ط§ظ„ظ…ط­ط§ط³ط¨ط© ط§ظ„ط¹ط§ظ…ط© ====================

// --- ط¯ظ„ظٹظ„ ط§ظ„ط­ط³ط§ط¨ط§طھ (ط´ط¬ط±ط©) ---
function buildAccountsTree() {
    const container = document.getElementById('accountsTree');
    function buildNode(parentId) {
        const children = DB.accounts.filter(a => a.parent === parentId);
        if (!children.length) return '';
        let html = '';
        children.forEach(a => {
            const sub = buildNode(a.id);
            const balStr = a.balance !== undefined ? `<span style="margin-right:auto;color:${a.nature==='ظ…ط¯ظٹظ†'?'var(--success)':'var(--danger)'};font-size:.8rem;font-weight:700">${(a.balance||0).toLocaleString()} ط±ظٹط§ظ„</span>` : '';
            const typeClr = a.type==='ط±ط¦ظٹط³ظٹ'?'var(--warning)':a.type==='ظپط±ط¹ظٹ'?'var(--secondary)':'var(--muted)';
            const icon = sub ? 'fa-folder' : 'fa-file-invoice-dollar';
            html += `<div class="tree-node${sub?' ':' open'}">
                <div class="tree-label" onclick="this.parentElement.classList.toggle('open')" style="gap:8px">
                    <i class="fa-solid ${icon}" style="color:${typeClr}"></i>
                    <span style="color:${typeClr};font-size:.7rem;font-weight:700">${a.code}</span>
                    <span>${a.name}</span>
                    ${balStr}
                    <div class="act" style="margin-right:8px" onclick="event.stopPropagation()">
                        <button class="btn-edit" onclick="editItem('account','${a.id}')" style="width:24px;height:24px;font-size:.65rem"><i class="fa-solid fa-pen"></i></button>
                        <button class="btn-delete" onclick="delItem('account','${a.id}','${a.name}')" style="width:24px;height:24px;font-size:.65rem"><i class="fa-solid fa-trash"></i></button>
                    </div>
                </div>
                ${sub?'<div class="tree-children" style="display:block">'+sub+'</div>':''}
            </div>`;
        });
        return html;
    }
    container.innerHTML = buildNode(null) || '<p style="color:var(--muted);text-align:center">ظ„ط§ طھظˆط¬ط¯ ط­ط³ط§ط¨ط§طھ</p>';
}

