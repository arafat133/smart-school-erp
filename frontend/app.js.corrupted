        const badge = a.deducted ? `<span style="color:var(--success)"><i class="fa-solid fa-check"></i> ظ…ط®طµظˆظ…ط©</span>` : `<span style="color:var(--warning)"><i class="fa-solid fa-clock"></i> ط؛ظٹط± ظ…ط®طµظˆظ…ط©</span>`;
        tb.innerHTML += `<tr><td>${a.date}</td><td>${a.empName}</td><td style="font-weight:700;color:var(--danger)">${a.amount.toLocaleString()} ط±ظٹط§ظ„</td><td>${a.note}</td><td>${badge}</td><td>${a.deducted?'--':`<div class="act"><button class="btn-delete" onclick="delItem('advance',${a.id},'ط³ظ„ظپط© ${a.empName}')"><i class="fa-solid fa-trash"></i></button></div>`}</td></tr>`;
    });
}

function generatePayroll() {
    const month = document.getElementById('payrollMonth')?.value, tb = document.getElementById('tbl-payroll');
    tb.innerHTML = '';
    if (!month) return;
    
    let totalNet = 0;
    
    DB.employees.filter(e=>e.status==='ظ†ط´ط·').forEach(e => {
        // 1. ط§ظ„ط£ط³ط§ط³ظٹ
        const contract = DB.contracts.find(c => c.empName === e.name && c.status === 'ط³ط§ط±ظٹ');
        if (!contract) return; // ظ…ظˆط¸ظپ ط¨ط¯ظˆظ† ط¹ظ‚ط¯ ظ„ط§ ظٹظ†ط²ظ„ ظپظٹ ط§ظ„ظ…ط³ظٹط±
        const basic = contract.salary;
        
        // 2. ط§ظ„ط³ظ„ظپظٹط§طھ ط؛ظٹط± ط§ظ„ظ…ط®طµظˆظ…ط© (ظ‚ط¨ظ„ ط£ظˆ ط®ظ„ط§ظ„ ظ‡ط°ط§ ط§ظ„ط´ظ‡ط±)
        const activeAdvances = DB.advances.filter(a => a.empName === e.name && !a.deducted && a.date.startsWith(month));
        const advancesSum = activeAdvances.reduce((sum,a) => sum + a.amount, 0);
        
        // 3. ط§ظ„ط؛ظٹط§ط¨ط§طھ (ظ„ط؛ط±ط¶ ط§ظ„ظ…ط­ط§ظƒط§ط©: ظ†ظپطھط±ط¶ ط®طµظ… ظٹظˆظ…ظٹط© ط¹ظ† ظƒظ„ ظٹظˆظ… ط؛ظٹط§ط¨)
        const absences = DB.empAttendance.filter(a => a.empName === e.name && a.date.startsWith(month) && a.status === 'ط؛ط§ط¦ط¨');
        const dailyRate = basic / 30;
        const absentDeduct = Math.round(absences.length * dailyRate);
        
        // 4. ط§ظ„طµط§ظپظٹ
        const net = basic - advancesSum - absentDeduct;
        totalNet += net;
        
        tb.innerHTML += `<tr>
            <td>${e.name}</td>
            <td>${basic.toLocaleString()}</td>
            <td>0</td>
            <td style="color:var(--danger)">${advancesSum > 0 ? '-'+advancesSum.toLocaleString() : '0'}</td>
            <td style="color:var(--danger)">${absentDeduct > 0 ? '-'+absentDeduct.toLocaleString() : '0'}</td>
            <td style="font-weight:700;color:var(--primary)">${net.toLocaleString()}</td>
        </tr>`;
    });
    
    document.getElementById('prTotalNet').textContent = totalNet.toLocaleString();
}

function postPayroll() {
    const month = document.getElementById('payrollMonth')?.value;
    if (!month) return toast('âڑ ï¸ڈ ظٹط±ط¬ظ‰ طھط­ط¯ظٹط¯ ط§ظ„ط´ظ‡ط±',1);
    if (!document.getElementById('tbl-payroll').innerHTML) return toast('âڑ ï¸ڈ ظ„ط§ ظٹظˆط¬ط¯ ظ…ط³ظٹط± ظ„ط§ط¹طھظ…ط§ط¯ظ‡',1);
    
    // طھط³ط¬ظٹظ„ ط§ظ„ظ‚ظٹظˆط¯
    const netTxt = document.getElementById('prTotalNet').textContent.replace(/,/g,'');
    const totalNet = parseInt(netTxt) || 0;
    
    if (totalNet > 0) {
        DB.journal.push({id:nextId.journal++, number:`JE-${String(nextId.journal).padStart(3,'0')}`, date:new Date().toLocaleDateString('en-CA'), desc:`ط±ظˆط§طھط¨ ظˆط£ط¬ظˆط± ط´ظ‡ط± ${month}`, debitAcc:'ط§ظ„ط±ظˆط§طھط¨ ظˆط§ظ„ط£ط¬ظˆط±', creditAcc:'ط§ظ„ط±ظˆط§طھط¨ ط§ظ„ظ…ط³طھط­ظ‚ط©', debit:totalNet, credit:totalNet, posted:true});
    }
    
    // طھطµظپظٹط± ط§ظ„ط³ظ„ظپظٹط§طھ ط§ظ„ظ…ط±طھط¨ط·ط© ط¨ط§ظ„ط´ظ‡ط±
    DB.advances.filter(a => !a.deducted && a.date.startsWith(month)).forEach(a => a.deducted = true);
    
    addAudit('ظ…ظˆط¸ظپظٹظ† / ط­ط³ط§ط¨ط§طھ', `ط§ط¹طھظ…ط§ط¯ ظˆطھط±ط­ظٹظ„ ظ…ط³ظٹط± ط±ظˆط§طھط¨ ط´ظ‡ط± ${month}`);
    toast('طھظ… ط§ط¹طھظ…ط§ط¯ ظ…ط³ظٹط± ط§ظ„ط±ظˆط§طھط¨ ظˆطھط±ط­ظٹظ„ظ‡ ظ„ظ„ظ‚ظٹظˆط¯ ط§ظ„ظ…ط­ط§ط³ط¨ظٹط© ًں’°');
    
    // ط¥ط¹ط§ط¯ط© ط§ظ„طھط­ظ…ظٹظ„ ظ„ط¥ط¸ظ‡ط§ط± طھط£ط«ظٹط± طھطµظپظٹط± ط§ظ„ط³ظ„ظپظٹط§طھ ط¥ظ† ط£ط±ط¯ظ†ط§
    generatePayroll();
}

