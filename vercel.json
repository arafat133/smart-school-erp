{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/school", "destination": "/school.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/saas", "destination": "/admin.html" },
    { "source": "/parent", "destination": "/parent.html" },
    { "source": "/parents", "destination": "/parent.html" },
    { "source": "/motion", "destination": "/frontend/motion/index.html" },
    { "source": "/motion/(.*)", "destination": "/frontend/motion/$1" }
  ]
}
